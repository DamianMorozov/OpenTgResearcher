<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:OpenTgResearcherDesktop.Converters"
    xmlns:convertersWinUI="using:CommunityToolkit.WinUI.Converters"
    xmlns:styles="using:OpenTgResearcherDesktop.Styles">

    <!--  Общий знак OTR для заставки и верхней панели, с необязательным слоем сканирования  -->
    <Style x:Key="TgAppLogoStyle" TargetType="ContentControl">
        <Setter Property="Width" Value="80" />
        <Setter Property="Height" Value="80" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border
                        Width="80"
                        Height="80"
                        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                        BorderBrush="{ThemeResource SystemControlForegroundAccentBrush}"
                        BorderThickness="2"
                        CornerRadius="40">
                        <Grid Width="76" Height="76">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,76,76" />
                            </Grid.Clip>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="28"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="OTR" />
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Стиль кнопки копирования с анимацией галочки  -->
    <Style x:Key="ClipboardAnimatedButtonStyleSimple" TargetType="styles:TgAnimatedClipboardButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="styles:TgAnimatedClipboardButton">
                    <Grid x:Name="RootGrid">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <SymbolIcon x:Name="ClipboardIcon" Symbol="{TemplateBinding NormalSymbol}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="IconStates">
                                <!--  Обычное состояние  -->
                                <VisualState x:Name="NormalState">
                                    <VisualState.Setters>
                                        <Setter Target="ClipboardIcon.Symbol" Value="{Binding NormalSymbol, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <Setter Target="IconScale.ScaleX" Value="1" />
                                        <Setter Target="IconScale.ScaleY" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <!--  Состояние подтверждения  -->
                                <VisualState x:Name="CheckedState">
                                    <VisualState.Setters>
                                        <Setter Target="ClipboardIcon.Symbol" Value="{Binding CheckedSymbol, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </VisualState.Setters>
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <!--  Увеличение и уменьшение масштаба  -->
                                            <DoubleAnimation
                                                AutoReverse="True"
                                                Storyboard.TargetName="IconScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                From="1"
                                                To="1.3"
                                                Duration="0:0:0.15" />
                                            <DoubleAnimation
                                                AutoReverse="True"
                                                Storyboard.TargetName="IconScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                From="1"
                                                To="1.3"
                                                Duration="0:0:0.15" />
                                        </Storyboard>
                                    </VisualState.Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Стиль кнопки копирования с анимацией галочки и вспышки  -->
    <Style x:Key="ClipboardAnimatedButtonStyle" TargetType="styles:TgAnimatedClipboardButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="styles:TgAnimatedClipboardButton">
                    <Grid x:Name="RootGrid">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <!--  Значок  -->
                        <SymbolIcon
                            x:Name="ClipboardIcon"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Symbol="{TemplateBinding NormalSymbol}" />
                        <!--  Слой мягкой цветовой вспышки  -->
                        <Ellipse
                            x:Name="FlashOverlay"
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                    <!--  Яркий акцентный цвет в центре  -->
                                    <GradientStop Offset="0" Color="{ThemeResource SystemAccentColor}" />
                                    <!--  Прозрачные края  -->
                                    <GradientStop Offset="1" Color="Transparent" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="IconStates">
                                <!--  Обычное состояние  -->
                                <VisualState x:Name="NormalState">
                                    <VisualState.Setters>
                                        <Setter Target="ClipboardIcon.Symbol" Value="{Binding NormalSymbol, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <Setter Target="IconScale.ScaleX" Value="1" />
                                        <Setter Target="IconScale.ScaleY" Value="1" />
                                        <Setter Target="FlashOverlay.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <!--  Состояние подтверждения  -->
                                <VisualState x:Name="CheckedState">
                                    <VisualState.Setters>
                                        <Setter Target="ClipboardIcon.Symbol" Value="{Binding CheckedSymbol, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </VisualState.Setters>
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <!--  Масштаб  -->
                                            <DoubleAnimation
                                                AutoReverse="True"
                                                Storyboard.TargetName="IconScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                From="1"
                                                To="1.3"
                                                Duration="0:0:0.15" />
                                            <DoubleAnimation
                                                AutoReverse="True"
                                                Storyboard.TargetName="IconScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                From="1"
                                                To="1.3"
                                                Duration="0:0:0.15" />
                                            <!--  Вспышка  -->
                                            <DoubleAnimation
                                                AutoReverse="True"
                                                Storyboard.TargetName="FlashOverlay"
                                                Storyboard.TargetProperty="Opacity"
                                                From="0"
                                                To="0.8"
                                                Duration="0:0:0.12" />
                                        </Storyboard>
                                    </VisualState.Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Стиль кнопки с проверкой лицензии  -->
    <Style
        x:Key="LicenseButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="styles:TgLicenseButton">
        <Setter Property="Background" Value="{ThemeResource SystemControlBackgroundAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

</ResourceDictionary>
