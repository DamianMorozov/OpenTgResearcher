<Page
    x:Class="OpenTgResearcherDesktop.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:OpenTgResearcherDesktop.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:OpenTgResearcherDesktop.Helpers"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:l="using:WinUI3Localizer"
    xmlns:lottie="using:CommunityToolkit.WinUI.Lottie"
    xmlns:styles="using:OpenTgResearcherDesktop.Styles"
    xmlns:viewmodels="using:OpenTgResearcherDesktop.ViewModels"
    xmlns:winui="using:Microsoft.UI.Xaml.Controls"
    x:Name="ShellPageRoot"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <Grid>
        <!--  Заголовок и управление приложением  -->
        <Grid
            x:Name="AppTitleBar"
            Height="{Binding ElementName=NavigationViewControl, Path=CompactPaneLength}"
            VerticalAlignment="Top"
            Canvas.ZIndex="1"
            IsHitTestVisible="True"
            SizeChanged="AppTitleBar_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="80" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--  Перетаскивание доступно только в области значка и заголовка  -->
            <Grid x:Name="TitleBarDragRegion" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="28"
                    Height="28"
                    Source="/Assets/applicationIcon.ico" />
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,16,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Grid>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <!--  Выбор языка с немедленным сохранением  -->
                <Button
                    x:Name="ToolbarLanguageButton"
                    Height="36"
                    MinWidth="40"
                    Padding="10,0"
                    AutomationProperties.AutomationId="ToolbarLanguage">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE774;" />
                        <TextBlock
                            x:Name="ToolbarLanguageLabel"
                            VerticalAlignment="Center"
                            l:Uids.Uid="ToolbarLanguage"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <RadioMenuFlyoutItem
                                l:Uids.Uid="ToolbarSystemLanguage"
                                Command="{x:Bind ViewModel.ChangeLanguageCommand}"
                                CommandParameter="Default"
                                GroupName="ToolbarLanguages"
                                IsChecked="{x:Bind ViewModel.IsLanguageSelected(ViewModel.SettingsService.AppLanguage, 'Default'), Mode=OneWay}" />
                            <RadioMenuFlyoutItem
                                Command="{x:Bind ViewModel.ChangeLanguageCommand}"
                                CommandParameter="English"
                                GroupName="ToolbarLanguages"
                                IsChecked="{x:Bind ViewModel.IsLanguageSelected(ViewModel.SettingsService.AppLanguage, 'English'), Mode=OneWay}"
                                Text="English" />
                            <RadioMenuFlyoutItem
                                Command="{x:Bind ViewModel.ChangeLanguageCommand}"
                                CommandParameter="Russian"
                                GroupName="ToolbarLanguages"
                                IsChecked="{x:Bind ViewModel.IsLanguageSelected(ViewModel.SettingsService.AppLanguage, 'Russian'), Mode=OneWay}"
                                Text="Русский" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <!--  Выбор системной, светлой или тёмной темы  -->
                <Button
                    x:Name="ToolbarThemeButton"
                    Height="36"
                    MinWidth="40"
                    Padding="10,0"
                    AutomationProperties.AutomationId="ToolbarTheme">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE790;" />
                        <TextBlock
                            x:Name="ToolbarThemeLabel"
                            VerticalAlignment="Center"
                            l:Uids.Uid="ToolbarTheme"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <RadioMenuFlyoutItem
                                l:Uids.Uid="ToolbarSystemTheme"
                                Command="{x:Bind ViewModel.ChangeThemeCommand}"
                                CommandParameter="Default"
                                GroupName="ToolbarThemes"
                                IsChecked="{x:Bind ViewModel.IsThemeSelected(ViewModel.SettingsService.AppTheme, 'Default'), Mode=OneWay}" />
                            <RadioMenuFlyoutItem
                                l:Uids.Uid="ToolbarLightTheme"
                                Command="{x:Bind ViewModel.ChangeThemeCommand}"
                                CommandParameter="Light"
                                GroupName="ToolbarThemes"
                                IsChecked="{x:Bind ViewModel.IsThemeSelected(ViewModel.SettingsService.AppTheme, 'Light'), Mode=OneWay}" />
                            <RadioMenuFlyoutItem
                                l:Uids.Uid="ToolbarDarkTheme"
                                Command="{x:Bind ViewModel.ChangeThemeCommand}"
                                CommandParameter="Dark"
                                GroupName="ToolbarThemes"
                                IsChecked="{x:Bind ViewModel.IsThemeSelected(ViewModel.SettingsService.AppTheme, 'Dark'), Mode=OneWay}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <!--  Проверка стабильного выпуска с общим журналом и подтверждением  -->
                <Button
                    x:Name="ToolbarUpdateButton"
                    Height="36"
                    MinWidth="40"
                    Padding="10,0"
                    AutomationProperties.AutomationId="ToolbarUpdate"
                    Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                    IsEnabled="{x:Bind ViewModel.Updates.IsUpdating, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE895;" />
                        <TextBlock
                            x:Name="ToolbarUpdateLabel"
                            VerticalAlignment="Center"
                            l:Uids.Uid="ToolbarUpdate"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Button>
                <Border
                    Width="1"
                    Height="24"
                    Margin="6,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <!--  Подключение к Telegram  -->
                <Button
                    x:Name="ToolbarConnectButton"
                    Height="36"
                    MinWidth="40"
                    Padding="10,0"
                    AutomationProperties.AutomationId="ToolbarConnect"
                    Command="{x:Bind ViewModel.ClientConnectCommand}"
                    IsEnabled="{x:Bind ViewModel.IsOnlineReady, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                    <Button.CommandParameter>
                        <x:Boolean>False</x:Boolean>
                    </Button.CommandParameter>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE930;" />
                        <TextBlock
                            x:Name="ToolbarConnectLabel"
                            VerticalAlignment="Center"
                            l:Uids.Uid="ClientConnect"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Button>
                <!--  Отключение от Telegram  -->
                <Button
                    x:Name="ToolbarDisconnectButton"
                    Height="36"
                    MinWidth="40"
                    Padding="10,0"
                    AutomationProperties.AutomationId="ToolbarDisconnect"
                    Command="{x:Bind ViewModel.ClientDisconnectCommand}"
                    IsEnabled="{x:Bind ViewModel.IsOnlineReady, Mode=OneWay}">
                    <Button.CommandParameter>
                        <x:Boolean>False</x:Boolean>
                    </Button.CommandParameter>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xEA39;" />
                        <TextBlock
                            x:Name="ToolbarDisconnectLabel"
                            VerticalAlignment="Center"
                            l:Uids.Uid="ClientDisconnect"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <!--  Навигация  -->
        <NavigationView
            x:Name="NavigationViewControl"
            Canvas.ZIndex="0"
            DisplayModeChanged="NavigationViewControl_DisplayModeChanged"
            ExpandedModeThresholdWidth="600"
            Header="{x:Bind ((ContentControl)ViewModel.Selected).Content, Mode=OneWay}"
            IsBackButtonVisible="Visible"
            IsBackEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
            IsSettingsVisible="True"
            ItemInvoked="NavigationViewControl_ItemInvoked"
            OpenPaneLength="270"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}">
            <!--  Шаблон заголовка навигации  -->
            <NavigationView.HeaderTemplate>
                <DataTemplate>
                    <Grid>
                        <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{Binding}" />
                    </Grid>
                </DataTemplate>
            </NavigationView.HeaderTemplate>
            <!--  Пункты меню навигации  -->
            <NavigationView.MenuItems>
                <!--  Главная страница  -->
                <NavigationViewItem helpers:TgNavigationHelper.NavigateTo="OpenTgResearcherDesktop.ViewModels.TgMainViewModel" l:Uids.Uid="Shell_Home">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--  Хранилище  -->
                <NavigationViewItem helpers:TgNavigationHelper.NavigateTo="OpenTgResearcherDesktop.ViewModels.TgStorageViewModel" l:Uids.Uid="Shell_Storage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEBC3;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--  Подключение клиента  -->
                <NavigationViewItem helpers:TgNavigationHelper.NavigateTo="OpenTgResearcherDesktop.ViewModels.TgClientConnectionViewModel" l:Uids.Uid="Shell_ClientConnection">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xED5C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--  Фильтры  -->
                <NavigationViewItem helpers:TgNavigationHelper.NavigateTo="OpenTgResearcherDesktop.ViewModels.TgFiltersViewModel" l:Uids.Uid="Shell_Filters">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE71C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--  Прокси  -->
                <NavigationViewItem helpers:TgNavigationHelper.NavigateTo="OpenTgResearcherDesktop.ViewModels.TgProxiesViewModel" l:Uids.Uid="Shell_Proxies">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEDA3;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--  Истории  -->
                <NavigationViewItem helpers:TgNavigationHelper.NavigateTo="OpenTgResearcherDesktop.ViewModels.TgStoriesViewModel" l:Uids.Uid="Shell_Stories">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--  Чаты  -->
                <NavigationViewItem helpers:TgNavigationHelper.NavigateTo="OpenTgResearcherDesktop.ViewModels.TgChatsViewModel" l:Uids.Uid="Shell_Chats">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE90A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--  Сохранённые сообщения  -->
                <NavigationViewItem
                    helpers:TgNavigationHelper.NavigateTo="OpenTgResearcherDesktop.ViewModels.TgChatViewModel"
                    helpers:TgNavigationHelper.NavigationParameter="{x:Bind ViewModel.UidSavedMessages, Mode=OneWay}"
                    l:Uids.Uid="Shell_SavedMessages"
                    IsEnabled="{x:Bind ViewModel.IsOnlineReady, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7C1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--  Пользователи  -->
                <NavigationViewItem helpers:TgNavigationHelper.NavigateTo="OpenTgResearcherDesktop.ViewModels.TgUsersViewModel" l:Uids.Uid="Shell_UsersAndContacts">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8D4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--  Оборудование  -->
                <NavigationViewItem helpers:TgNavigationHelper.NavigateTo="OpenTgResearcherDesktop.ViewModels.TgHardwareResourceViewModel" l:Uids.Uid="Shell_Equipment">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE950;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--  Журналы  -->
                <NavigationViewItem helpers:TgNavigationHelper.NavigateTo="OpenTgResearcherDesktop.ViewModels.TgLogsViewModel" l:Uids.Uid="Shell_Logs">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--  Обновление  -->
                <NavigationViewItem helpers:TgNavigationHelper.NavigateTo="OpenTgResearcherDesktop.ViewModels.TgUpdateViewModel" l:Uids.Uid="Shell_Update">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--  Лицензия  -->
                <NavigationViewItem helpers:TgNavigationHelper.NavigateTo="OpenTgResearcherDesktop.ViewModels.TgLicenseViewModel" l:Uids.Uid="Shell_License">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE719;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <!--  Поведение навигации  -->
            <i:Interaction.Behaviors>
                <behaviors:NavigationViewHeaderBehavior DefaultHeader="{x:Bind ((ContentControl)ViewModel.Selected).Content, Mode=OneWay}">
                    <behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                        <DataTemplate>
                            <Grid Margin="-60,-10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <!--  Обновление страницы  -->
                                <Button
                                    Grid.Column="0"
                                    Width="45"
                                    Height="45"
                                    Margin="10,0,10,0"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding DataContext.UpdatePageCommand, ElementName=ShellPageRoot}">
                                    <FontIcon Glyph="&#xE72C;" />
                                </Button>
                                <!--  Заголовок страницы  -->
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource TitleTextBlockStyle}"
                                    Text="{Binding}" />
                                <!--  Переключатель отображения конфиденциальных данных  -->
                                <ToggleSwitch
                                    x:Name="ToggleSwitchShowSensitiveData"
                                    Grid.Column="2"
                                    Margin="10,5,15,-5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    l:Uids.Uid="ToggleSwitchShowSensitiveData"
                                    IsOn="True"
                                    Toggled="ToggleSwitchShowSecretFields_Toggled" />
                            </Grid>
                        </DataTemplate>
                    </behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                </behaviors:NavigationViewHeaderBehavior>
            </i:Interaction.Behaviors>
            <!--  Содержимое страницы  -->
            <Grid Margin="{StaticResource NavigationViewPageContentMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Frame x:Name="NavigationFrame" />
                <Border
                    Grid.Row="1"
                    Padding="0,5,0,5"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,1,0,0">
                    <Border.Background>
                        <SolidColorBrush Opacity="0.5" Color="{ThemeResource SystemControlBackgroundBaseLowBrush}" />
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!--  Обработка запросов хранилища  -->
                        <FontIcon
                            Grid.Column="0"
                            Margin="5,0,5,0"
                            Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                            Glyph="&#xEBC3;"
                            Visibility="{x:Bind ViewModel.IsStorageProcessing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <ProgressRing
                            Grid.Column="0"
                            Width="16"
                            Height="16"
                            Margin="5,0,5,0"
                            IsActive="True"
                            Visibility="{x:Bind ViewModel.IsStorageProcessing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="5,0,5,0"
                            l:Uids.Uid="DataStorage"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Visibility="{x:Bind ViewModel.IsExistsAppStorage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <FontIcon
                            Grid.Column="2"
                            Margin="5,0,5,0"
                            Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                            Glyph="&#xE930;"
                            Visibility="{x:Bind ViewModel.IsExistsAppStorage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <FontIcon
                            Grid.Column="2"
                            Margin="5,0,5,0"
                            Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                            Glyph="&#xEA39;"
                            Visibility="{x:Bind ViewModel.IsExistsAppStorage, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <TextBlock
                            Grid.Column="3"
                            Grid.ColumnSpan="2"
                            Margin="5,0,5,0"
                            l:Uids.Uid="DataWaitStorageProcessing"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind ViewModel.IsStorageProcessing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock
                            Grid.Column="4"
                            Grid.ColumnSpan="2"
                            Margin="5,0,5,0"
                            l:Uids.Uid="AppStorageNeedToCreate"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Visibility="{x:Bind ViewModel.IsExistsAppStorage, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <!--  Обработка сетевых запросов  -->
                        <FontIcon
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="5,0,5,0"
                            Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                            Glyph="&#xEDE4;"
                            Visibility="{x:Bind ViewModel.IsOnlineProcessing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <ProgressRing
                            Grid.Row="1"
                            Grid.Column="0"
                            Width="16"
                            Height="16"
                            Margin="5,0,5,0"
                            IsActive="True"
                            Visibility="{x:Bind ViewModel.IsOnlineProcessing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="5,0,5,0"
                            l:Uids.Uid="FieldNetwork"
                            Style="{ThemeResource BodyTextBlockStyle}" />
                        <FontIcon
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="5,0,5,0"
                            Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                            Glyph="&#xE930;"
                            Visibility="{x:Bind ViewModel.IsOnlineReady, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <FontIcon
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="5,0,5,0"
                            Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                            Glyph="&#xEA39;"
                            Visibility="{x:Bind ViewModel.IsOnlineReady, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="3"
                            Margin="5,0,5,0"
                            l:Uids.Uid="DataWaitOnlineProcessing"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind ViewModel.IsOnlineProcessing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="4"
                            Margin="5,0,5,0"
                            l:Uids.Uid="AppOnlineNeedToConnet"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Visibility="{x:Bind ViewModel.IsOnlineReady, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <!--  Защита от флуда  -->
                        <FontIcon
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="5,0,5,0"
                            Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                            Glyph="&#xEF31;"
                            Visibility="{x:Bind ViewModel.IsFloodVisible, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <ProgressRing
                            Grid.Row="2"
                            Grid.Column="0"
                            Width="16"
                            Height="16"
                            Margin="5,0,5,0"
                            IsActive="True"
                            Visibility="{x:Bind ViewModel.IsFloodVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="5,0,5,0"
                            l:Uids.Uid="FloodControl"
                            Style="{ThemeResource BodyTextBlockStyle}" />
                        <FontIcon
                            Grid.Row="2"
                            Grid.Column="2"
                            Margin="5,0,5,0"
                            Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                            Glyph="&#xE930;"
                            Visibility="{x:Bind ViewModel.IsFloodVisible, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <FontIcon
                            Grid.Row="2"
                            Grid.Column="2"
                            Margin="5,0,5,0"
                            Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                            Glyph="&#xEA39;"
                            Visibility="{x:Bind ViewModel.IsFloodVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="3"
                            Margin="5,0,5,0"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Visibility="{x:Bind ViewModel.IsFloodVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Run l:Uids.Uid="RunWait" />
                            <Run Text="{x:Bind ViewModel.FloodWaitSeconds, Mode=OneWay}" />
                            <Run l:Uids.Uid="RunSeconds" />
                        </TextBlock>
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="4"
                            Margin="5,0,5,0"
                            VerticalAlignment="Center"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.FloodMessage, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactToolbar">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="WideToolbar">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1200" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ToolbarLanguageLabel.Visibility" Value="Visible" />
                        <Setter Target="ToolbarThemeLabel.Visibility" Value="Visible" />
                        <Setter Target="ToolbarUpdateLabel.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ExtraWideToolbar">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1600" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ToolbarLanguageLabel.Visibility" Value="Visible" />
                        <Setter Target="ToolbarThemeLabel.Visibility" Value="Visible" />
                        <Setter Target="ToolbarUpdateLabel.Visibility" Value="Visible" />
                        <Setter Target="ToolbarConnectLabel.Visibility" Value="Visible" />
                        <Setter Target="ToolbarDisconnectLabel.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
