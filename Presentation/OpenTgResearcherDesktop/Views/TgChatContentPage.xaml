<common:TgPageBase
    x:Class="OpenTgResearcherDesktop.Views.TgChatContentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:OpenTgResearcherDesktop.Common"
    xmlns:helpers="using:OpenTgResearcherDesktop.Helpers"
    xmlns:l="using:WinUI3Localizer"
    xmlns:messages="using:TgStorage.Domain.Messages">
    <common:TgPageBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/TgChatResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!--  Лента сохраняет текст, файлы и обложки, метаданные раскрываются отдельно  -->
            <DataTemplate x:Key="MessagesViewTemplate" x:DataType="messages:TgEfMessageDto">
                <Border Margin="0,0,0,12" Style="{StaticResource ChatSurface}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture
                                Width="36"
                                Height="36"
                                DisplayName="{x:Bind UserContact, Mode=OneWay}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind UserContact, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource ChatSecondary}" Text="{x:Bind DtChangedString, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                        <RichTextBlock
                            helpers:TgMessageTextHelper.Content="{x:Bind Content, Mode=OneWay}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                        <!--  Медиа занимают отдельную строку и не сжимают текст сообщения  -->
                        <Image
                            MaxWidth="480"
                            MaxHeight="280"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="MessageImage"
                            AutomationProperties.Name="{x:Bind FileName, Mode=OneWay}"
                            Source="{x:Bind ImageFullPath, Mode=OneWay, Converter={StaticResource SafeImagePathConverter}}"
                            Stretch="Uniform"
                            Tapped="OnImagePreviewClick"
                            Visibility="{x:Bind IsImageExists, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Grid
                            x:Name="MessageMediaHost"
                            DataContextChanged="OnMediaHostContextChanged"
                            Unloaded="OnMediaHostUnloaded">
                            <StackPanel Spacing="8">
                                <Image
                                    MaxWidth="480"
                                    MaxHeight="280"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.AutomationId="MessageThumbnail"
                                    AutomationProperties.Name="{x:Bind FileName, Mode=OneWay}"
                                    Source="{x:Bind ThumbFullPath, Mode=OneWay, Converter={StaticResource SafeImagePathConverter}}"
                                    Stretch="Uniform"
                                    Tag="{x:Bind MediaFullPath, Mode=OneWay}"
                                    Tapped="OnMediaPreviewClick"
                                    Visibility="{x:Bind IsThumbExists, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button
                                    l:Uids.Uid="ChatPlayMedia"
                                    AutomationProperties.AutomationId="ChatPlayMedia"
                                    Click="OnPlayMediaClick"
                                    Tag="{x:Bind MediaFullPath, Mode=OneWay}"
                                    Visibility="{x:Bind helpers:TgChatMediaPlayback.PlayButtonVisibility(MediaFullPath), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                        <Button
                            l:Uids.Uid="ChatOpenMedia"
                            AutomationProperties.AutomationId="ChatOpenMedia"
                            Click="OnOpenMediaClick"
                            Tag="{x:Bind MediaFullPath, Mode=OneWay}"
                            Visibility="{x:Bind IsMediaExists, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                                <TextBlock l:Uids.Uid="ChatOpenMediaLabel" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource ChatSecondary}" Text="{x:Bind FileName, Mode=OneWay}" />
                        <Expander
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            l:Uids.Uid="ChatMessageDetails">
                            <StackPanel Spacing="8">
                                <TextBlock l:Uids.Uid="TextBlockId" Style="{StaticResource ChatSecondary}" />
                                <TextBlock Style="{StaticResource ChatValue}" Text="{x:Bind Id, Mode=OneWay}" />
                                <TextBlock l:Uids.Uid="TextBlockSender" Style="{StaticResource ChatSecondary}" />
                                <TextBlock Style="{StaticResource ChatValue}" Text="{x:Bind SenderDisplay, Mode=OneWay}" />
                                <TextBlock l:Uids.Uid="ChatMessageSize" Style="{StaticResource ChatSecondary}" />
                                <TextBlock Style="{StaticResource ChatValue}" Text="{x:Bind Size, Mode=OneWay}" />
                                <HyperlinkButton
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="OnOpenHyperlink"
                                    Content="{x:Bind Link, Mode=OneWay}"
                                    Tag="{x:Bind Link, Mode=OneWay}" />
                                <TextBlock l:Uids.Uid="TextBlockMessageDeleted" Visibility="{x:Bind IsDeleted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </common:TgPageBase.Resources>
    <Grid Margin="12,0,16,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource ChatSecondary}"
                Text="{x:Bind ViewModel.LoadedDataStatistics, Mode=OneWay}" />
            <Button
                Grid.Column="1"
                AutomationProperties.AutomationId="ClearChatContent"
                Command="{x:Bind ViewModel.ClearViewCommand}">
                <TextBlock l:Uids.Uid="ActionClearView" TextWrapping="Wrap" />
            </Button>
        </Grid>
        <Grid Grid.Row="1">
            <Grid Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    l:Uids.Uid="FieldEmptyData"
                    Visibility="{x:Bind ViewModel.IsEmptyData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            <!--  ListView владеет прокруткой и сохраняет виртуализацию длинной ленты  -->
            <ListView
                x:Name="ListViewMessages"
                AutomationProperties.AutomationId="ChatMessagesFeed"
                ItemTemplate="{StaticResource MessagesViewTemplate}"
                ItemsSource="{x:Bind ViewModel.MessageDtos, Mode=OneWay}"
                ScrollViewer.HorizontalScrollMode="Disabled"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.Footer>
                    <Button
                        Margin="0,8,0,16"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="ChatLoadMoreMessages"
                        Command="{x:Bind ViewModel.LazyLoadMessagesCommand}"
                        IsEnabled="{x:Bind ViewModel.HasMoreMessages, Mode=OneWay}">
                        <TextBlock l:Uids.Uid="TextBlockLoadMore" />
                    </Button>
                </ListView.Footer>
            </ListView>
            <!--  Увеличенное изображение закрывается нажатием и скрывается вместе с конфиденциальными данными  -->
            <Grid Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border
                    AutomationProperties.AutomationId="ChatImageViewer"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    Tapped="OnFullScreenImageTapped"
                    Visibility="{x:Bind ViewModel.IsImageViewerVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Image
                        x:Name="FullScreenImage"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ChatFullScreenImage"
                        Stretch="Uniform" />
                </Border>
            </Grid>
        </Grid>
        <InfoBar
            x:Name="MediaError"
            Grid.Row="1"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="False"
            Severity="Warning" />
    </Grid>
</common:TgPageBase>
