<common:TgPageBase
    x:Class="OpenTgResearcherDesktop.Views.TgChatContentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:OpenTgResearcherDesktop.Common"
    xmlns:l="using:WinUI3Localizer"
    xmlns:messages="using:TgStorage.Domain.Messages">
    <common:TgPageBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/TgChatResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Лента сохраняет текст, файлы и обложки, метаданные раскрываются отдельно -->
            <DataTemplate x:Key="MessagesViewTemplate" x:DataType="messages:TgEfMessageDto">
                <Border Style="{StaticResource ChatSurface}" Margin="0,0,0,12">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <PersonPicture Width="36" Height="36" DisplayName="{x:Bind UserContact, Mode=OneWay}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind UserContact, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind DtChangedString, Mode=OneWay}" Style="{StaticResource ChatSecondary}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{x:Bind MessageText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <!-- Медиа занимают отдельную строку и не сжимают текст сообщения -->
                        <Image AutomationProperties.AutomationId="MessageImage" AutomationProperties.Name="{x:Bind FileName, Mode=OneWay}"
                            MaxWidth="480" MaxHeight="280" HorizontalAlignment="Left" Stretch="Uniform" Tapped="OnImagePreviewClick"
                            Source="{x:Bind ImageFullPath, Mode=OneWay, Converter={StaticResource SafeImagePathConverter}}"
                            Visibility="{x:Bind IsImageExists, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Image AutomationProperties.AutomationId="MessageThumbnail" AutomationProperties.Name="{x:Bind FileName, Mode=OneWay}"
                            MaxWidth="480" MaxHeight="280" HorizontalAlignment="Left" Stretch="Uniform" Tapped="OnImagePreviewClick"
                            Source="{x:Bind ThumbFullPath, Mode=OneWay, Converter={StaticResource SafeImagePathConverter}}"
                            Visibility="{x:Bind IsThumbExists, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind FileName, Mode=OneWay}" Style="{StaticResource ChatSecondary}" />
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" l:Uids.Uid="ChatMessageDetails">
                            <StackPanel Spacing="8">
                                <TextBlock l:Uids.Uid="TextBlockId" Style="{StaticResource ChatSecondary}" />
                                <TextBlock Text="{x:Bind Id, Mode=OneWay}" Style="{StaticResource ChatValue}" />
                                <TextBlock l:Uids.Uid="TextBlockSender" Style="{StaticResource ChatSecondary}" />
                                <TextBlock Text="{x:Bind SenderDisplay, Mode=OneWay}" Style="{StaticResource ChatValue}" />
                                <TextBlock l:Uids.Uid="ChatMessageSize" Style="{StaticResource ChatSecondary}" />
                                <TextBlock Text="{x:Bind Size, Mode=OneWay}" Style="{StaticResource ChatValue}" />
                                <HyperlinkButton Click="OnOpenHyperlink" Content="{x:Bind Link, Mode=OneWay}" Tag="{x:Bind Link, Mode=OneWay}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                <TextBlock l:Uids.Uid="TextBlockMessageDeleted"
                                    Visibility="{x:Bind IsDeleted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </common:TgPageBase.Resources>
    <Grid Margin="12,0,16,12" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.LoadedDataStatistics, Mode=OneWay}" Style="{StaticResource ChatSecondary}" />
            <Button Grid.Column="1" AutomationProperties.AutomationId="ClearChatContent" Command="{x:Bind ViewModel.ClearViewCommand}">
                <TextBlock l:Uids.Uid="ActionClearView" TextWrapping="Wrap" />
            </Button>
        </Grid>
        <Grid Grid.Row="1">
            <Grid Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock l:Uids.Uid="FieldEmptyData" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsEmptyData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            <!-- ListView владеет прокруткой и сохраняет виртуализацию длинной ленты -->
            <ListView x:Name="ListViewMessages" AutomationProperties.AutomationId="ChatMessagesFeed"
                SelectionMode="None" ItemsSource="{x:Bind ViewModel.MessageDtos, Mode=OneWay}"
                ItemTemplate="{StaticResource MessagesViewTemplate}" ScrollViewer.HorizontalScrollMode="Disabled"
                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" />
                </Style></ListView.ItemContainerStyle>
                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" /></ItemsPanelTemplate></ListView.ItemsPanel>
                <ListView.Footer>
                    <Button HorizontalAlignment="Center" Margin="0,8,0,16" Command="{x:Bind ViewModel.LazyLoadMessagesCommand}"
                        AutomationProperties.AutomationId="ChatLoadMoreMessages" IsEnabled="{x:Bind ViewModel.HasMoreMessages, Mode=OneWay}">
                        <TextBlock l:Uids.Uid="TextBlockLoadMore" />
                    </Button>
                </ListView.Footer>
            </ListView>
            <!-- Увеличенное изображение закрывается нажатием и скрывается вместе с конфиденциальными данными -->
            <Grid Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Tapped="OnFullScreenImageTapped"
                    AutomationProperties.AutomationId="ChatImageViewer"
                    Visibility="{x:Bind ViewModel.IsImageViewerVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Image x:Name="FullScreenImage" AutomationProperties.AutomationId="ChatFullScreenImage"
                        Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</common:TgPageBase>
