<common:TgPageBase
    x:Class="OpenTgResearcherDesktop.Views.TgChatDownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:OpenTgResearcherDesktop.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:OpenTgResearcherDesktop.Helpers"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:messages="using:TgStorage.Domain.Messages"
    xmlns:styles="using:OpenTgResearcherDesktop.Styles"
    xmlns:users="using:TgStorage.Domain.Users"
    xmlns:viewmodels="using:OpenTgResearcherDesktop.ViewModels"
    xmlns:views="using:OpenTgResearcherDesktop.Views"
    d:DataContext="{d:DesignInstance Type=viewmodels:TgChatDownloadViewModel}"
    mc:Ignorable="d">

    <ContentControl
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Visibility="{x:Bind ViewModel.IsStorageProcessing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
        <Border
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{x:Bind ViewModel.IsOnlineProcessing, Mode=OneWay, Converter={StaticResource BoolToObjectConverter}}"
            CornerRadius="5">
            <Grid Margin="0,0,10,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <!--  Начальный идентификатор  -->
                <TextBlock
                    Grid.Row="0"
                    l:Uids.Uid="FieldFirstId"
                    Style="{StaticResource FieldTextBlockStyle}"
                    TextWrapping="Wrap" />
                <NumberBox
                    Grid.Row="0"
                    Grid.Column="1"
                    IsEnabled="{x:Bind ViewModel.IsOnlineProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                    Minimum="1"
                    SpinButtonPlacementMode="Compact"
                    Style="{StaticResource FieldNumberBoxStyle}"
                    Value="{x:Bind ViewModel.DownloadDto.FirstId, Mode=TwoWay}" />
                <!--  Количество потоков  -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    l:Uids.Uid="FieldCountThreads"
                    Style="{StaticResource FieldTextBlockStyle}"
                    TextWrapping="Wrap" />
                <NumberBox
                    Grid.Row="0"
                    Grid.Column="3"
                    IsEnabled="{x:Bind ViewModel.IsOnlineProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                    Maximum="{x:Bind ViewModel.DownloadSettings.LimitThreads, Mode=OneWay}"
                    Minimum="1"
                    SpinButtonPlacementMode="Compact"
                    Style="{StaticResource FieldNumberBoxStyle}"
                    Value="{x:Bind ViewModel.DownloadDto.CountThreads, Mode=TwoWay}" />
                <!--  Автообновление  -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="4"
                    l:Uids.Uid="FieldIsAutoUpdate"
                    Style="{StaticResource FieldTextBlockStyle}"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    Grid.Row="0"
                    Grid.Column="5"
                    AutomationProperties.AutomationId="ChatAutoUpdate"
                    IsEnabled="{x:Bind ViewModel.IsOnlineProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                    IsOn="{x:Bind ViewModel.DownloadDto.IsAutoUpdate, Mode=TwoWay}"
                    Style="{StaticResource FieldToggleSwitchStyle}" />
                <!--  Сохранение сообщений  -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    l:Uids.Uid="FieldIsParseMessages"
                    Style="{StaticResource FieldTextBlockStyle}"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    Grid.Row="1"
                    Grid.Column="1"
                    IsEnabled="{x:Bind ViewModel.IsOnlineProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                    IsOn="{x:Bind ViewModel.DownloadDto.IsSaveMessages, Mode=TwoWay}"
                    AutomationProperties.AutomationId="ChatParseMessages"
                    Style="{StaticResource FieldToggleSwitchStyle}" />
                <!--  Добавление идентификатора к имени файла  -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    l:Uids.Uid="FieldIsJoinFileNameWithMessageId"
                    Style="{StaticResource FieldTextBlockStyle}"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    Grid.Row="1"
                    Grid.Column="3"
                    IsEnabled="{x:Bind ViewModel.IsOnlineProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                    IsOn="{x:Bind ViewModel.DownloadDto.IsJoinFileNameWithMessageId, Mode=TwoWay}"
                    AutomationProperties.AutomationId="ChatJoinMessageId"
                    Style="{StaticResource FieldToggleSwitchStyle}" />
                <!--  Перезапись сообщений  -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="4"
                    l:Uids.Uid="FieldIsRewriteMessages"
                    Style="{StaticResource FieldTextBlockStyle}"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    Grid.Row="1"
                    Grid.Column="5"
                    IsEnabled="{x:Bind ViewModel.IsOnlineProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                    IsOn="{x:Bind ViewModel.DownloadDto.IsRewriteMessages, Mode=TwoWay}"
                    Style="{StaticResource FieldToggleSwitchStyle}" />
                <!--  Скачивание файлов  -->
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    l:Uids.Uid="FieldIsDownloadFiles"
                    Style="{StaticResource FieldTextBlockStyle}"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    Grid.Row="2"
                    Grid.Column="1"
                    IsEnabled="{x:Bind ViewModel.IsOnlineProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                    IsOn="{x:Bind ViewModel.DownloadDto.IsSaveFiles, Mode=TwoWay}"
                    AutomationProperties.AutomationId="ChatDownloadFiles"
                    Style="{StaticResource FieldToggleSwitchStyle}" />
                <!--  Скачивание обложек  -->
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="2"
                    l:Uids.Uid="FieldIsDownloadThumbnail"
                    Style="{StaticResource FieldTextBlockStyle}"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    Grid.Row="2"
                    Grid.Column="3"
                    Margin="12,0,0,0"
                    IsEnabled="{x:Bind ViewModel.IsOnlineProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                    IsOn="{x:Bind ViewModel.DownloadDto.IsDownloadThumbnail, Mode=TwoWay}"
                    AutomationProperties.AutomationId="ChatDownloadThumbnail"
                    Style="{StaticResource FieldToggleSwitchStyle}" />
                <!--  Перезапись файлов  -->
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="4"
                    l:Uids.Uid="FieldIsRewriteFiles"
                    Style="{StaticResource FieldTextBlockStyle}"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    Grid.Row="2"
                    Grid.Column="5"
                    IsEnabled="{x:Bind ViewModel.IsOnlineProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                    IsOn="{x:Bind ViewModel.DownloadDto.IsRewriteFiles, Mode=TwoWay}"
                    Style="{StaticResource FieldToggleSwitchStyle}" />
                <!--  Разбор комментариев  -->
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    l:Uids.Uid="FieldIsParseComments"
                    Style="{StaticResource FieldTextBlockStyle}"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    Grid.Row="3"
                    Grid.Column="1"
                    IsEnabled="{x:Bind ViewModel.IsOnlineProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                    IsOn="{x:Bind ViewModel.DownloadDto.IsParsingComments, Mode=TwoWay}"
                    AutomationProperties.AutomationId="ChatParseComments"
                    Style="{StaticResource FieldToggleSwitchStyle}" />
                <!--  Создание подкаталогов  -->
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="2"
                    l:Uids.Uid="FieldIsCreateSubdirectories"
                    Style="{StaticResource FieldTextBlockStyle}"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    Grid.Row="3"
                    Grid.Column="3"
                    IsEnabled="{x:Bind ViewModel.IsOnlineProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                    IsOn="{x:Bind ViewModel.DownloadDto.IsCreatingSubdirectories, Mode=TwoWay}"
                    AutomationProperties.AutomationId="ChatCreateSubdirectories"
                    Style="{StaticResource FieldToggleSwitchStyle}" />
                <!--  Имя файла по сообщению  -->
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="4"
                    l:Uids.Uid="FieldIsFileNameByMessage"
                    Style="{StaticResource FieldTextBlockStyle}"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    Grid.Row="3"
                    Grid.Column="5"
                    IsEnabled="{x:Bind ViewModel.IsOnlineProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                    IsOn="{x:Bind ViewModel.DownloadDto.IsFileNamingByMessage, Mode=TwoWay}"
                    Style="{StaticResource FieldToggleSwitchStyle}" />
                <!--  Каталог  -->
                <TextBlock
                    Grid.Row="5"
                    l:Uids.Uid="FieldDirectory"
                    Style="{StaticResource FieldTextBlockStyle}"
                    TextWrapping="Wrap" />
                <Grid
                    Grid.Row="5"
                    Grid.Column="1"
                    Grid.ColumnSpan="5"
                    Margin="2"
                    HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  Конфиденциальные данные  -->
                    <TextBlock
                        Margin="2,10,2,2"
                        HorizontalAlignment="Stretch"
                        HorizontalTextAlignment="Left"
                        Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <TextBox
                        IsReadOnly="{x:Bind ViewModel.IsOnlineProcessing, Mode=OneWay}"
                        Style="{StaticResource FieldTextBoxStyle}"
                        Text="{x:Bind ViewModel.DownloadDto.Directory, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <styles:TgAnimatedClipboardButton
                        Grid.Column="1"
                        Click="OnClipboardSilentWriteClick"
                        Style="{StaticResource ClipboardAnimatedButtonStyle}"
                        Tag="{x:Bind ViewModel.DownloadDto.Directory, Mode=OneWay}" />
                </Grid>
                <!--  Прогресс разбора  -->
                <TextBlock
                    Grid.Row="6"
                    Grid.Column="0"
                    l:Uids.Uid="FieldPercent"
                    Style="{StaticResource FieldTextBlockStyle}"
                    TextWrapping="Wrap" />
                <TextBox
                    Grid.Row="6"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="ChatDownloadPercent"
                    IsReadOnly="True"
                    Style="{StaticResource FieldTextBoxStyle}"
                    Text="{x:Bind ViewModel.ChatProgressMessage, Mode=OneWay}" />
                <TextBox
                    Grid.Row="6"
                    Grid.Column="2"
                    Grid.ColumnSpan="4"
                    IsReadOnly="True"
                    Style="{StaticResource FieldTextBoxStyle}"
                    Text="{x:Bind ViewModel.ChatProgressInfo, Mode=OneWay}" />
                <!--  Потоки сообщений  -->
                <TextBlock
                    Grid.Row="7"
                    Grid.Column="0"
                    l:Uids.Uid="FieldMessageParsingStreams"
                    Style="{StaticResource FieldTextBlockStyle}"
                    TextWrapping="Wrap" />
                <TextBox
                    Grid.Row="7"
                    Grid.Column="1"
                    IsReadOnly="True"
                    Style="{StaticResource FieldTextBoxStyle}"
                    Text="{x:Bind ViewModel.StateMessageParsingStreams, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBox
                    Grid.Row="7"
                    Grid.Column="2"
                    Grid.ColumnSpan="4"
                    IsReadOnly="True"
                    Style="{StaticResource FieldTextBoxStyle}"
                    Text="{x:Bind ViewModel.StateSourceMsg, Mode=OneWay}" />
                <!--  Потоки медиа  -->
                <TextBlock
                    Grid.Row="8"
                    Grid.Column="0"
                    l:Uids.Uid="FieldMediaParsingStreams"
                    Style="{StaticResource FieldTextBlockStyle}"
                    TextWrapping="Wrap" />
                <TextBox
                    Grid.Row="8"
                    Grid.Column="1"
                    IsReadOnly="True"
                    Style="{StaticResource FieldTextBoxStyle}"
                    Text="{x:Bind ViewModel.StateMediaParsingStreams, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBox
                    Grid.Row="8"
                    Grid.Column="2"
                    Grid.ColumnSpan="4"
                    IsReadOnly="True"
                    Style="{StaticResource FieldTextBoxStyle}"
                    Text="{x:Bind ViewModel.StateSourceMedia, Mode=OneWay}" />
                <!--  Переход к сетевой активности доступен во время парсинга  -->
                <Button
                    Grid.Row="9"
                    Grid.ColumnSpan="6"
                    Margin="2,10,2,2"
                    Padding="12,8"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="ChatOpenNetworkActivity"
                    AutomationProperties.LabeledBy="{x:Bind OpenNetworkActivityLabel}"
                    Command="{x:Bind ViewModel.OpenNetworkActivityCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE968;" />
                        <TextBlock x:Name="OpenNetworkActivityLabel" VerticalAlignment="Center" l:Uids.Uid="ActionOpenNetworkActivity" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </ContentControl>
</common:TgPageBase>
