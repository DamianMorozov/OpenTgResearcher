<common:TgPageBase
    x:Class="OpenTgResearcherDesktop.Views.TgChatDownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:OpenTgResearcherDesktop.Common"
    xmlns:l="using:WinUI3Localizer"
    xmlns:styles="using:OpenTgResearcherDesktop.Styles">
    <common:TgPageBase.Resources>
        <Style x:Key="ChatCard" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="ChatCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ChatHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </common:TgPageBase.Resources>
    <Grid>
        <!--  Прокрутка принадлежит только обзору, таблицы других вкладок измеряются отдельно  -->
        <ScrollViewer
            AutomationProperties.AutomationId="ChatOverviewScroll"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,0,16,20" Spacing="16">
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition x:Name="OptionsColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="16">
                        <!--  Состояние и прогресс читаются из настоящих сетевых операций выбранного чата  -->
                        <Border Style="{StaticResource ChatCard}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <styles:TgOutlineIcon Kind="activity" />
                                        <TextBlock l:Uids.Uid="ChatParsingTitle" Style="{StaticResource ChatHeading}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            AutomationProperties.AutomationId="ChatConnectionStatus"
                                            Style="{StaticResource ChatCaption}"
                                            Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource ChatCaption}" Text="·" />
                                        <TextBlock Style="{StaticResource ChatCaption}" Text="{x:Bind ViewModel.ParsingStatus, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        MinWidth="130"
                                        Padding="0"
                                        AutomationProperties.AutomationId="ChatDownloadPercent"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="32"
                                        FontWeight="SemiBold"
                                        IsReadOnly="True"
                                        Text="{x:Bind ViewModel.ChatProgressMessage, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ChatCaption}"
                                        Text="{x:Bind ViewModel.ChatProgressInfo, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </Grid>
                                <ProgressBar
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{x:Bind ViewModel.ParsingProgress, Mode=OneWay}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Padding="10,10"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="ChatStartParsing"
                                        AutomationProperties.LabeledBy="{x:Bind StartParsingLabel}"
                                        Command="{x:Bind ViewModel.Chat.StartUpdateOnlineCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanStartParsing, Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="{x:Bind ViewModel.HasRunningParsing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon FontSize="16" Glyph="&#xE768;" />
                                            <TextBlock
                                                x:Name="StartParsingLabel"
                                                Grid.Column="1"
                                                l:Uids.Uid="ChatStart"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                    <Button
                                        Padding="10,10"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="ChatPauseParsing"
                                        Command="{x:Bind ViewModel.PauseParsingCommand}"
                                        Visibility="{x:Bind ViewModel.HasRunningParsing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind ViewModel.PauseCaption, Mode=OneWay}" TextWrapping="Wrap" />
                                    </Button>
                                    <Button
                                        Grid.Column="1"
                                        Padding="10,10"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="ChatStopParsing"
                                        Command="{x:Bind ViewModel.StopParsingCommand}">
                                        <TextBlock l:Uids.Uid="ChatStop" TextWrapping="Wrap" />
                                    </Button>
                                </Grid>
                                <TextBlock
                                    l:Uids.Uid="ChatSaveBeforeStart"
                                    FontSize="12"
                                    Style="{StaticResource ChatCaption}" />
                                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasCurrentFile, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock
                                        l:Uids.Uid="ChatCurrentFile"
                                        FontSize="12"
                                        Style="{StaticResource ChatCaption}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.CurrentFile, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.CurrentFile, Mode=OneWay}" />
                                    <ProgressBar Value="{x:Bind ViewModel.FileProgress, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource ChatCaption}" Text="{x:Bind ViewModel.CurrentTransfer, Mode=OneWay}" />
                                </StackPanel>
                                <!--  Переход к сетевой активности доступен во время парсинга  -->
                                <Button
                                    Padding="12,8"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="ChatOpenNetworkActivity"
                                    AutomationProperties.LabeledBy="{x:Bind OpenNetworkActivityLabel}"
                                    Command="{x:Bind ViewModel.OpenNetworkActivityCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <styles:TgOutlineIcon
                                            Width="16"
                                            Height="16"
                                            Kind="network" />
                                        <TextBlock
                                            x:Name="OpenNetworkActivityLabel"
                                            l:Uids.Uid="ActionOpenNetworkActivity"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <!--  Каталог и позиция остаются частью общего несохранённого черновика  -->
                        <Border Style="{StaticResource ChatCard}">
                            <StackPanel Spacing="14">
                                <TextBlock l:Uids.Uid="ChatDownloadSettings" Style="{StaticResource ChatHeading}" />
                                <StackPanel Spacing="6">
                                    <TextBlock l:Uids.Uid="FieldDirectory" Style="{StaticResource ChatCaption}" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            AutomationProperties.AutomationId="ChatDirectory"
                                            IsReadOnly="{x:Bind ViewModel.HasRunningParsing, Mode=OneWay}"
                                            Text="{x:Bind ViewModel.DownloadDto.Directory, Mode=TwoWay}"
                                            Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                        <styles:TgAnimatedClipboardButton
                                            Grid.Column="1"
                                            Click="OnClipboardSilentWriteClick"
                                            Style="{StaticResource ClipboardAnimatedButtonStyle}"
                                            Tag="{x:Bind ViewModel.DownloadDto.Directory, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6">
                                        <TextBlock l:Uids.Uid="FieldFirstId" Style="{StaticResource ChatCaption}" />
                                        <NumberBox
                                            IsEnabled="{x:Bind ViewModel.HasRunningParsing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                            Minimum="1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{x:Bind ViewModel.DownloadDto.FirstId, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock l:Uids.Uid="FieldCountThreads" Style="{StaticResource ChatCaption}" />
                                        <NumberBox
                                            IsEnabled="{x:Bind ViewModel.HasRunningParsing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                            Maximum="{x:Bind ViewModel.DownloadSettings.LimitThreads, Mode=OneWay}"
                                            Minimum="1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{x:Bind ViewModel.DownloadDto.CountThreads, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Expander
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="ChatAdvanced">
                            <Expander.Header>
                                <TextBlock l:Uids.Uid="ChatAdvancedTitle" TextWrapping="Wrap" />
                            </Expander.Header>
                            <StackPanel Spacing="6">
                                <Grid
                                    Padding="0,10"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="3">
                                        <TextBlock
                                            x:Name="ChatRewriteMessagesLabel"
                                            l:Uids.Uid="FieldIsRewriteMessages"
                                            TextWrapping="Wrap" />

                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        MinWidth="44"
                                        AutomationProperties.AutomationId="ChatRewriteMessages"
                                        AutomationProperties.LabeledBy="{x:Bind ChatRewriteMessagesLabel}"
                                        IsEnabled="{x:Bind ViewModel.HasRunningParsing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                        IsOn="{x:Bind ViewModel.DownloadDto.IsRewriteMessages, Mode=TwoWay}"
                                        OffContent=""
                                        OnContent="" />
                                </Grid>
                                <Grid
                                    Padding="0,10"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="3">
                                        <TextBlock
                                            x:Name="ChatRewriteFilesLabel"
                                            l:Uids.Uid="FieldIsRewriteFiles"
                                            TextWrapping="Wrap" />

                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        MinWidth="44"
                                        AutomationProperties.AutomationId="ChatRewriteFiles"
                                        AutomationProperties.LabeledBy="{x:Bind ChatRewriteFilesLabel}"
                                        IsEnabled="{x:Bind ViewModel.HasRunningParsing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                        IsOn="{x:Bind ViewModel.DownloadDto.IsRewriteFiles, Mode=TwoWay}"
                                        OffContent=""
                                        OnContent="" />
                                </Grid>
                                <Grid
                                    Padding="0,10"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="3">
                                        <TextBlock
                                            x:Name="ChatFileNameByMessageLabel"
                                            l:Uids.Uid="FieldIsFileNameByMessage"
                                            TextWrapping="Wrap" />

                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        MinWidth="44"
                                        AutomationProperties.AutomationId="ChatFileNameByMessage"
                                        AutomationProperties.LabeledBy="{x:Bind ChatFileNameByMessageLabel}"
                                        IsEnabled="{x:Bind ViewModel.HasRunningParsing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                        IsOn="{x:Bind ViewModel.DownloadDto.IsFileNamingByMessage, Mode=TwoWay}"
                                        OffContent=""
                                        OnContent="" />
                                </Grid>
                                <TextBlock l:Uids.Uid="FieldMessageParsingStreams" Style="{StaticResource ChatCaption}" />
                                <TextBlock Text="{x:Bind ViewModel.StateMessageParsingStreams, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock l:Uids.Uid="FieldMediaParsingStreams" Style="{StaticResource ChatCaption}" />
                                <TextBlock Text="{x:Bind ViewModel.StateMediaParsingStreams, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <!--  Семь основных опций с короткими пояснениями и компактными переключателями  -->
                    <Border
                        x:Name="OptionsCard"
                        Grid.Row="1"
                        VerticalAlignment="Top"
                        Style="{StaticResource ChatCard}">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Margin="0,0,0,4"
                                l:Uids.Uid="ChatCollectTitle"
                                Style="{StaticResource ChatHeading}" />
                            <Grid
                                Padding="0,10"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                    <TextBlock
                                        x:Name="ChatParseMessagesLabel"
                                        l:Uids.Uid="FieldIsParseMessages"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        l:Uids.Uid="ChatMessagesHint"
                                        FontSize="12"
                                        Style="{StaticResource ChatCaption}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="44"
                                    AutomationProperties.AutomationId="ChatParseMessages"
                                    AutomationProperties.LabeledBy="{x:Bind ChatParseMessagesLabel}"
                                    IsEnabled="{x:Bind ViewModel.HasRunningParsing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                    IsOn="{x:Bind ViewModel.DownloadDto.IsSaveMessages, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                            <Grid
                                Padding="0,10"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                    <TextBlock
                                        x:Name="ChatDownloadFilesLabel"
                                        l:Uids.Uid="FieldIsDownloadFiles"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        l:Uids.Uid="ChatFilesHint"
                                        FontSize="12"
                                        Style="{StaticResource ChatCaption}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="44"
                                    AutomationProperties.AutomationId="ChatDownloadFiles"
                                    AutomationProperties.LabeledBy="{x:Bind ChatDownloadFilesLabel}"
                                    IsEnabled="{x:Bind ViewModel.HasRunningParsing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                    IsOn="{x:Bind ViewModel.DownloadDto.IsSaveFiles, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                            <Grid
                                Padding="0,10"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                    <TextBlock
                                        x:Name="ChatParseCommentsLabel"
                                        l:Uids.Uid="FieldIsParseComments"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        l:Uids.Uid="ChatCommentsHint"
                                        FontSize="12"
                                        Style="{StaticResource ChatCaption}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="44"
                                    AutomationProperties.AutomationId="ChatParseComments"
                                    AutomationProperties.LabeledBy="{x:Bind ChatParseCommentsLabel}"
                                    IsEnabled="{x:Bind ViewModel.HasRunningParsing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                    IsOn="{x:Bind ViewModel.DownloadDto.IsParsingComments, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                            <Grid
                                Padding="0,10"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                    <TextBlock
                                        x:Name="ChatJoinMessageIdLabel"
                                        l:Uids.Uid="ChatJoinIdLabel"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        l:Uids.Uid="ChatJoinIdHint"
                                        FontSize="12"
                                        Style="{StaticResource ChatCaption}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="44"
                                    AutomationProperties.AutomationId="ChatJoinMessageId"
                                    AutomationProperties.LabeledBy="{x:Bind ChatJoinMessageIdLabel}"
                                    IsEnabled="{x:Bind ViewModel.HasRunningParsing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                    IsOn="{x:Bind ViewModel.DownloadDto.IsJoinFileNameWithMessageId, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                            <Grid
                                Padding="0,10"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                    <TextBlock
                                        x:Name="ChatDownloadThumbnailLabel"
                                        l:Uids.Uid="FieldIsDownloadThumbnail"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        l:Uids.Uid="ChatThumbnailsHint"
                                        FontSize="12"
                                        Style="{StaticResource ChatCaption}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="44"
                                    AutomationProperties.AutomationId="ChatDownloadThumbnail"
                                    AutomationProperties.LabeledBy="{x:Bind ChatDownloadThumbnailLabel}"
                                    IsEnabled="{x:Bind ViewModel.HasRunningParsing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                    IsOn="{x:Bind ViewModel.DownloadDto.IsDownloadThumbnail, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                            <Grid
                                Padding="0,10"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                    <TextBlock
                                        x:Name="ChatCreateSubdirectoriesLabel"
                                        l:Uids.Uid="FieldIsCreateSubdirectories"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        l:Uids.Uid="ChatFoldersHint"
                                        FontSize="12"
                                        Style="{StaticResource ChatCaption}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="44"
                                    AutomationProperties.AutomationId="ChatCreateSubdirectories"
                                    AutomationProperties.LabeledBy="{x:Bind ChatCreateSubdirectoriesLabel}"
                                    IsEnabled="{x:Bind ViewModel.HasRunningParsing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                    IsOn="{x:Bind ViewModel.DownloadDto.IsCreatingSubdirectories, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                            <Grid
                                Padding="0,10"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                    <TextBlock
                                        x:Name="ChatAutoUpdateLabel"
                                        l:Uids.Uid="FieldIsAutoUpdate"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        l:Uids.Uid="ChatAutoUpdateHint"
                                        FontSize="12"
                                        Style="{StaticResource ChatCaption}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="44"
                                    AutomationProperties.AutomationId="ChatAutoUpdate"
                                    AutomationProperties.LabeledBy="{x:Bind ChatAutoUpdateLabel}"
                                    IsEnabled="{x:Bind ViewModel.HasRunningParsing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                    IsOn="{x:Bind ViewModel.DownloadDto.IsAutoUpdate, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                            <Button
                                Margin="0,16,0,0"
                                Padding="12,10"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="ChatSaveSettings"
                                AutomationProperties.LabeledBy="{x:Bind SaveChatSettingsLabel}"
                                Command="{x:Bind ViewModel.Chat.SaveChatSettingsCommand}"
                                IsEnabled="{x:Bind ViewModel.HasRunningParsing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                                <TextBlock
                                    x:Name="SaveChatSettingsLabel"
                                    l:Uids.Uid="TextBlockSaveChatSettings"
                                    TextWrapping="Wrap" />
                            </Button>
                            <Button
                                Padding="12,8"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="ChatResetSettings"
                                AutomationProperties.LabeledBy="{x:Bind ResetChatSettingsLabel}"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.Chat.ResetChatSettingsCommand}"
                                IsEnabled="{x:Bind ViewModel.HasRunningParsing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                                <TextBlock
                                    x:Name="ResetChatSettingsLabel"
                                    l:Uids.Uid="ActionResetChatSettings"
                                    TextWrapping="Wrap" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
                <!--  Сведения из хранилища доступны без сети, расширенные сведения запрашиваются при раскрытии  -->
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="ChatDetails"
                    Expanding="OnDetailsExpanding">
                    <Expander.Header>
                        <TextBlock l:Uids.Uid="ChatDetailsTitle" TextWrapping="Wrap" />
                    </Expander.Header>
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="FieldTitle" Style="{StaticResource ChatCaption}" />
                            <TextBox
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.DownloadDto.Title, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="FieldAbout" Style="{StaticResource ChatCaption}" />
                            <TextBox
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.DownloadDto.About, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock l:Uids.Uid="FieldUid" Style="{StaticResource ChatCaption}" />
                            <TextBox
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.DownloadDto.Uid, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
