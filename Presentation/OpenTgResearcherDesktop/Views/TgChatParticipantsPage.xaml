<common:TgPageBase x:Class="OpenTgResearcherDesktop.Views.TgChatParticipantsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:OpenTgResearcherDesktop.Common" xmlns:l="using:WinUI3Localizer"
    xmlns:styles="using:OpenTgResearcherDesktop.Styles" xmlns:users="using:TgStorage.Domain.Users">
    <common:TgPageBase.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ms-appx:///Styles/TgChatResources.xaml" /></ResourceDictionary.MergedDictionaries>
        <DataTemplate x:Key="ParticipantCatalogTemplate" x:DataType="users:TgEfUserDto">
            <Grid Padding="10,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <PersonPicture Width="38" Height="38" DisplayName="{x:Bind DisplayName, Mode=OneWay}" />
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind MainUserName, Mode=OneWay}" Style="{StaticResource ChatSecondary}" />
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock l:Uids.Uid="FieldMessagesCount" Style="{StaticResource ChatSecondary}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind MessagesCount, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </ResourceDictionary></common:TgPageBase.Resources>
    <Grid Margin="12,0,16,12" RowSpacing="12">
        <VisualStateManager.VisualStateGroups><VisualStateGroup>
            <VisualState x:Name="ParticipantsNarrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers></VisualState>
            <VisualState x:Name="ParticipantsWide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1050" /></VisualState.StateTriggers>
                <VisualState.Setters><Setter Target="DossierColumn.Width" Value="1.2*" /><Setter Target="DossierRow.Height" Value="0" />
                    <Setter Target="DossierPane.(Grid.Row)" Value="0" /><Setter Target="DossierPane.(Grid.Column)" Value="1" /></VisualState.Setters>
            </VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <!-- Основные действия отделены от источников получения участников -->
        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.LoadParticipantsCommand}" AutomationProperties.AutomationId="ChatParticipantsLoad">
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <styles:TgOutlineIcon Kind="refresh" /><TextBlock Grid.Column="1" l:Uids.Uid="ChatParticipantsLoad" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
            </Button>
            <Button Grid.Column="1" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.StopParticipantsCommand}">
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <styles:TgOutlineIcon Kind="pause" /><TextBlock Grid.Column="1" l:Uids.Uid="ChatParticipantsStop" TextWrapping="Wrap" />
                </Grid>
            </Button>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="8">
            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox AutomationProperties.AutomationId="ChatParticipantsSearch" l:Uids.Uid="ChatParticipantsFilter"
                    Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Command="{x:Bind ViewModel.SearchCommand}" AutomationProperties.AutomationId="ChatParticipantsFind">
                    <TextBlock l:Uids.Uid="ActionSearch" />
                </Button>
            </Grid>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox l:Uids.Uid="ChatFilterId" IsChecked="{x:Bind ViewModel.IsFilterById, Mode=TwoWay}" />
                    <CheckBox l:Uids.Uid="ChatFilterName" IsChecked="{x:Bind ViewModel.IsFilterByName, Mode=TwoWay}" />
                </StackPanel>
                <DropDownButton Grid.Column="1" l:Uids.Uid="ChatParticipantsActions" AutomationProperties.AutomationId="ChatParticipantsActions">
                    <DropDownButton.Flyout><MenuFlyout>
                        <MenuFlyoutItem l:Uids.Uid="ChatParticipantsFromTelegram" Command="{x:Bind ViewModel.GetParticipantsCommand}"
                            IsEnabled="{x:Bind ViewModel.IsOnlineReady, Mode=OneWay}" />
                        <MenuFlyoutItem l:Uids.Uid="ChatParticipantsFromMessages" AutomationProperties.AutomationId="ChatParticipantsFromMessages"
                            Command="{x:Bind ViewModel.GetParticipantsFromMessagesCommand}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem l:Uids.Uid="ChatParticipantsClear" Command="{x:Bind ViewModel.ClearParticipantsCommand}" />
                    </MenuFlyout></DropDownButton.Flyout>
                </DropDownButton>
            </Grid>
        </StackPanel>
        <!-- Каталог и досье имеют независимую прокрутку, в узком окне располагаются друг под другом -->
        <Grid Grid.Row="2" ColumnSpacing="16" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition x:Name="DossierRow" Height="*" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="DossierColumn" Width="0" /></Grid.ColumnDefinitions>
            <Grid Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock l:Uids.Uid="ChatParticipantsEmpty" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsEmptyData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            <ListView x:Name="ParticipantsCatalog" AutomationProperties.AutomationId="ChatParticipantsCatalog"
                ItemsSource="{x:Bind ViewModel.UserDtos, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedUser, Mode=TwoWay}"
                SelectionMode="Single" ItemTemplate="{StaticResource ParticipantCatalogTemplate}"
                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                </ListView.ItemContainerStyle>
            </ListView>
            <ScrollViewer x:Name="DossierPane" AutomationProperties.AutomationId="ChatParticipantDossier" Grid.Row="1"
                VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12">
                    <TextBlock l:Uids.Uid="ChatParticipantsSelect" Style="{StaticResource ChatSecondary}"
                        Visibility="{x:Bind ViewModel.HasSelectedUser, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <ContentControl HorizontalContentAlignment="Stretch" Content="{x:Bind ViewModel.SelectedUser, Mode=OneWay}"
                        ContentTemplate="{StaticResource ChatUserDossierTemplate}"
                        Visibility="{x:Bind ViewModel.HasSelectedUser, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button HorizontalAlignment="Stretch" Click="OnUserClick" Tag="{x:Bind ViewModel.SelectedUser.Uid, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasSelectedUser, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock l:Uids.Uid="ChatOpenUser" TextWrapping="Wrap" />
                    </Button>
                    <TextBlock l:Uids.Uid="ChatProfileStorageHint" Style="{StaticResource ChatSecondary}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</common:TgPageBase>
