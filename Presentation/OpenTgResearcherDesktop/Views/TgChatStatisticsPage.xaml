<common:TgPageBase x:Class="OpenTgResearcherDesktop.Views.TgChatStatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:OpenTgResearcherDesktop.Common" xmlns:l="using:WinUI3Localizer"
    xmlns:models="using:OpenTgResearcherDesktop.Models">
    <common:TgPageBase.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ms-appx:///Styles/TgChatResources.xaml" /></ResourceDictionary.MergedDictionaries>
        <DataTemplate x:Key="AuthorActivityTemplate" x:DataType="models:TgChatActivityRow">
            <Border Style="{StaticResource ChatSurface}" Margin="0,0,0,10">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock Text="{x:Bind User.DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind User.Id}" Style="{StaticResource ChatSecondary}" /></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                            <TextBlock Text="{x:Bind Messages}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Text="{x:Bind ShareText}" Style="{StaticResource ChatSecondary}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Relative}" />
                    <Button Click="OnUserClick" Tag="{x:Bind User.Uid}" HorizontalAlignment="Left">
                        <TextBlock l:Uids.Uid="ChatOpenUser" TextWrapping="Wrap" />
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>
    </ResourceDictionary></common:TgPageBase.Resources>
    <Grid Margin="12,0,16,12" RowSpacing="12">
        <VisualStateManager.VisualStateGroups><VisualStateGroup>
            <VisualState x:Name="StatisticsNarrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers></VisualState>
            <VisualState x:Name="StatisticsWide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000" /></VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="StartDateGroup.(Grid.ColumnSpan)" Value="1" /><Setter Target="EndDateGroup.(Grid.ColumnSpan)" Value="1" />
                    <Setter Target="EndDateGroup.(Grid.Row)" Value="0" /><Setter Target="EndDateGroup.(Grid.Column)" Value="1" />
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Expander l:Uids.Uid="ChatStatisticsPeriod" AutomationProperties.AutomationId="ChatStatisticsPeriod"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{x:Bind ViewModel.IsPeriodExpanded, Mode=TwoWay}">
            <StackPanel Spacing="12">
                <TextBlock l:Uids.Uid="ChatStatisticsTitle" Style="{StaticResource ChatTitle}" />
                <Grid ColumnSpacing="12" RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.ColumnSpan="2" Spacing="4" x:Name="StartDateGroup">
                        <TextBlock l:Uids.Uid="TextBlockDtStart" Style="{StaticResource ChatSecondary}" />
                        <DatePicker HorizontalAlignment="Left" SelectedDate="{x:Bind ViewModel.ChatStatisticsDto.DtStart, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel x:Name="EndDateGroup" Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                        <TextBlock l:Uids.Uid="TextBlockDtEnd" Style="{StaticResource ChatSecondary}" />
                        <DatePicker HorizontalAlignment="Left" SelectedDate="{x:Bind ViewModel.ChatStatisticsDto.DtEnd, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
                <Button AutomationProperties.AutomationId="ChatCalculateStatistics" Command="{x:Bind ViewModel.CalcChatStatisticsCommand}"
                    Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.IsOnlineReady, Mode=OneWay}">
                    <TextBlock l:Uids.Uid="ChatStatisticsCalculate" TextWrapping="Wrap" />
                </Button>
                <TextBlock l:Uids.Uid="ChatStatisticsHint" Style="{StaticResource ChatSecondary}" />
                <InfoBar IsOpen="{x:Bind ViewModel.HasStatisticsError, Mode=OneWay}" IsClosable="False" Severity="Error"
                    Message="{x:Bind ViewModel.StatisticsError, Mode=OneWay}" />
            </StackPanel>
        </Expander>
        <!-- Итоги относятся к сохранённым сообщениям выбранного периода -->
        <Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="8"
            Visibility="{x:Bind ViewModel.IsCalculated, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ChatSurface}">
                <StackPanel Spacing="3"><TextBlock l:Uids.Uid="ChatStatisticsMessages" Style="{StaticResource ChatSecondary}" />
                    <TextBlock Text="{x:Bind ViewModel.TotalMessages, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ChatSurface}">
                <StackPanel Spacing="3"><TextBlock l:Uids.Uid="ChatStatisticsAuthors" Style="{StaticResource ChatSecondary}" />
                    <TextBlock Text="{x:Bind ViewModel.ActiveAuthorsCount, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChatSurface}">
                <StackPanel Spacing="3"><TextBlock l:Uids.Uid="TextBlockUsers" Style="{StaticResource ChatSecondary}" />
                    <TextBlock Text="{x:Bind ViewModel.ChatStatisticsDto.UsersCount, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ChatSurface}">
                <StackPanel Spacing="3"><TextBlock l:Uids.Uid="ChatStatisticsBots" Style="{StaticResource ChatSecondary}" />
                    <TextBlock Text="{x:Bind ViewModel.ChatStatisticsDto.BotsCount, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" /></StackPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock l:Uids.Uid="ChatStatisticsRanking" Style="{StaticResource ChatTitle}" />
            <TextBlock l:Uids.Uid="ChatStatisticsNoResults" Style="{StaticResource ChatSecondary}"
                Visibility="{x:Bind ViewModel.HasNoMessages, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>
        <Grid Grid.Row="3">
            <Grid Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock l:Uids.Uid="ChatStatisticsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IsCalculated, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            <ListView x:Name="ListViewParticipantsStatistics" AutomationProperties.AutomationId="ChatStatisticsRanking"
                SelectionMode="None" ItemsSource="{x:Bind ViewModel.ActivityRows, Mode=OneWay}" ItemTemplate="{StaticResource AuthorActivityTemplate}"
                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" /></Style></ListView.ItemContainerStyle>
            </ListView>
        </Grid>
    </Grid>
</common:TgPageBase>
