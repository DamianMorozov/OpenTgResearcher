<common:TgPageBase
    x:Class="OpenTgResearcherDesktop.Views.TgChatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:OpenTgResearcherDesktop.Common"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:l="using:WinUI3Localizer"
    xmlns:models="using:OpenTgResearcherDesktop.Models"
    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives">
    <common:TgPageBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/TgChatResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="RegistryHeader" TargetType="primitives:DataGridColumnHeader">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="12,8" />
            </Style>
            <DataTemplate x:Key="RegistryIdentity" x:DataType="models:TgChatRegistryRow">
                <Grid Padding="8,10" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <PersonPicture
                        Width="34"
                        Height="34"
                        DisplayName="{x:Bind Title}" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="3">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTipService.ToolTip="{x:Bind Title}" />
                        <TextBlock
                            Style="{StaticResource ChatSecondary}"
                            Text="{x:Bind Identity}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="RegistryProgress" x:DataType="models:TgChatRegistryRow">
                <StackPanel
                    Margin="8,10"
                    VerticalAlignment="Center"
                    Spacing="5">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Style="{StaticResource ChatSecondary}"
                            Text="{x:Bind Status, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTipService.ToolTip="{x:Bind Status, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource ChatSecondary}"
                            Text="{x:Bind ProgressText, Mode=OneWay}" />
                    </Grid>
                    <ProgressBar
                        Height="4"
                        Maximum="100"
                        Value="{x:Bind Progress, Mode=OneWay}" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </common:TgPageBase.Resources>
    <Grid Margin="12,0,16,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--  Поиск и сортировка остаются доступными во время парсинга любого чата  -->
        <Grid ColumnSpacing="8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="SearchScopes" Grid.ColumnSpan="3" SelectionChanged="OnSearchScopeChanged"
                         AutomationProperties.AutomationId="ChatsSearchScope">
                <SelectorBarItem l:Uids.Uid="GlobalSearchLocal" IsSelected="True" Tag="0" />
                <SelectorBarItem l:Uids.Uid="GlobalSearchTelegram" Tag="1" />
            </SelectorBar>
            <TextBox
                x:Name="ChatSearchField"
                Grid.Row="1"
                MinWidth="120"
                l:Uids.Uid="GlobalSearchField"
                AutomationProperties.AutomationId="ChatFilter"
                KeyDown="FieldFilter_KeyDown"
                TextChanged="OnSearchTextChanged"
                Text="{x:Bind ViewModel.FilterText, Mode=TwoWay}" />
            <Button
                Grid.Row="1"
                Grid.Column="1"
                AutomationProperties.AutomationId="ChatSearch"
                Command="{x:Bind ViewModel.SearchChatsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE721;" />
                    <TextBlock l:Uids.Uid="ActionSearch" />
                </StackPanel>
            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="2"
                l:Uids.Uid="RegistryActions"
                AutomationProperties.AutomationId="ChatsActions"
                Visibility="{x:Bind ViewModel.IsLocalSearch, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            l:Uids.Uid="RegistrySync"
                            Command="{x:Bind ViewModel.StartUpdateOnlineCommand}"
                            IsEnabled="{x:Bind ViewModel.IsOnlineProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
                        <MenuFlyoutItem l:Uids.Uid="RegistryClear" Command="{x:Bind ViewModel.ClearViewCommand}" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem l:Uids.Uid="RegistryFilterId" IsChecked="{x:Bind ViewModel.IsFilterById, Mode=TwoWay}" />
                        <ToggleMenuFlyoutItem l:Uids.Uid="RegistryFilterName" IsChecked="{x:Bind ViewModel.IsFilterByName, Mode=TwoWay}" />
                        <ToggleMenuFlyoutItem l:Uids.Uid="RegistryFilterTitle" IsChecked="{x:Bind ViewModel.IsFilterByTitle, Mode=TwoWay}" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Text="{x:Bind ViewModel.PublicChatError, Mode=OneWay}" />
        </Grid>
        <Grid
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.IsLocalSearch, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
            ColumnSpacing="8"
            RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar
                x:Name="RegistryFilters"
                AutomationProperties.AutomationId="ChatsStatusFilter"
                SelectionChanged="OnRegistryFilterChanged">
                <SelectorBarItem
                    l:Uids.Uid="RegistryAll"
                    IsSelected="True"
                    Tag="0" />
                <SelectorBarItem l:Uids.Uid="RegistryWorking" Tag="1" />
                <SelectorBarItem l:Uids.Uid="RegistrySubscriptions" Tag="2" />
            </SelectorBar>
            <ComboBox
                Grid.Column="1"
                MinWidth="150"
                AutomationProperties.AutomationId="ChatsSort"
                SelectedIndex="{x:Bind ViewModel.RegistrySort, Mode=TwoWay}"
                SelectionChanged="OnRegistrySortChanged">
                <ComboBoxItem l:Uids.Uid="RegistrySortActivity" />
                <ComboBoxItem l:Uids.Uid="RegistrySortName" />
                <ComboBoxItem l:Uids.Uid="RegistrySortMessages" />
            </ComboBox>
            <TextBlock
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Style="{StaticResource ChatSecondary}"
                Text="{x:Bind ViewModel.LoadedDataStatistics, Mode=OneWay}" />

        </Grid>
        <!--  Таблица владеет прокруткой и не блокируется глобальными флагами сетевой операции  -->
        <StackPanel Grid.Row="1" Spacing="8"
                    Visibility="{x:Bind ViewModel.IsTelegramSearch, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock l:Uids.Uid="GlobalSearchHintLabel" Style="{StaticResource ChatSecondary}" />
            <SelectorBar x:Name="PublicKinds" SelectionChanged="OnPublicKindChanged" AutomationProperties.AutomationId="PublicSearchKind">
                <SelectorBarItem l:Uids.Uid="RegistryAll" IsSelected="True" Tag="0" />
                <SelectorBarItem l:Uids.Uid="GlobalSearchChannels" Tag="1" />
                <SelectorBarItem l:Uids.Uid="GlobalSearchGroups" Tag="2" />
            </SelectorBar>
            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind ViewModel.IsPublicSearchBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>
        <Grid Grid.Row="2" RowSpacing="12"
              Visibility="{x:Bind ViewModel.IsTelegramSearch, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            <Grid x:Name="PublicResultsLayout" RowSpacing="12" ColumnSpacing="12"
                  Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="PublicDetailsColumn" Width="400" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="2" Text="{x:Bind ViewModel.PublicSearchStatus, Mode=OneWay}" Style="{StaticResource ChatSecondary}"
                           AutomationProperties.LiveSetting="Polite" />
                <ListView x:Name="PublicSearchResultsList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.PublicSearchRows, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedPublicChat, Mode=TwoWay}" SelectionMode="Single"
                          IsItemClickEnabled="True" ItemClick="OnPublicResultClicked"
                          HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="PublicSearchResults">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TgPublicChatSearchRow">
                            <Grid Padding="8,12" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <PersonPicture Width="48" Height="48" DisplayName="{x:Bind Title}"
                                               ProfilePicture="{x:Bind Photo, Mode=OneWay, Converter={StaticResource PhotoBytesConverter}}" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Identity}" Style="{StaticResource ChatSecondary}" />
                                    <TextBlock Text="{x:Bind Kind, Mode=OneWay}" Style="{StaticResource ChatSecondary}" />
                                    <TextBlock Text="{x:Bind MembersText, Mode=OneWay}" Style="{StaticResource ChatSecondary}" />
                                    <TextBlock l:Uids.Uid="GlobalSearchSaved" Style="{StaticResource ChatSecondary}"
                                               Visibility="{x:Bind IsSaved, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <!--  Карточка справа раскрывается по выбору строки и не изменяет подписку Telegram  -->
                <Border x:Name="PublicSearchPreview" Grid.Row="1" Grid.Column="1" Style="{StaticResource ChatSurface}"
                        AutomationProperties.AutomationId="PublicSearchPreview"
                        Visibility="{x:Bind ViewModel.IsPublicProfileOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock l:Uids.Uid="GlobalProfileTitle" VerticalAlignment="Center" Style="{StaticResource ChatTitle}" />
                            <Button Grid.Column="1" l:Uids.Uid="GlobalProfileClose"
                                    Command="{x:Bind ViewModel.ClosePublicProfileCommand}" AutomationProperties.AutomationId="PublicProfileClose">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                            </Button>
                        </Grid>
                        <PersonPicture Width="104" Height="104" HorizontalAlignment="Center"
                                       DisplayName="{x:Bind ViewModel.SelectedPublicChat.Title, Mode=OneWay}"
                                       ProfilePicture="{x:Bind ViewModel.SelectedPublicChat.Photo, Mode=OneWay, Converter={StaticResource PhotoBytesConverter}}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedPublicChat.Title, Mode=OneWay}" Style="{StaticResource ChatTitle}" />
                        <TextBlock l:Uids.Uid="GlobalProfileVerified" Style="{StaticResource ChatSecondary}"
                                   Visibility="{x:Bind ViewModel.SelectedPublicChat.IsVerified, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedPublicChat.MembersText, Mode=OneWay}" Style="{StaticResource ChatSecondary}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedPublicChat.Identity, Mode=OneWay}" Style="{StaticResource ChatValue}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedPublicChat.Kind, Mode=OneWay}" Style="{StaticResource ChatSecondary}" />
                        <HyperlinkButton l:Uids.Uid="GlobalProfileOpenTelegram"
                                         NavigateUri="{x:Bind ViewModel.SelectedPublicChat.PublicLink, Mode=OneWay}" />
                        <ProgressBar IsIndeterminate="True"
                                     Visibility="{x:Bind ViewModel.SelectedPublicChat.IsProfileBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Expander l:Uids.Uid="GlobalProfileInformation" IsExpanded="True" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{x:Bind ViewModel.SelectedPublicChat.About, Mode=OneWay}"
                                           Style="{StaticResource ChatValue}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedPublicChat.UserNames, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <HyperlinkButton Content="{Binding}" NavigateUri="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <HyperlinkButton l:Uids.Uid="GlobalProfileDiscussion"
                                                 Visibility="{x:Bind ViewModel.SelectedPublicChat.HasDiscussion, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 NavigateUri="{x:Bind ViewModel.SelectedPublicChat.DiscussionLink, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedPublicChat.ProfileError, Mode=OneWay}" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedPublicChat.PhotoError, Mode=OneWay}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <Button l:Uids.Uid="GlobalProfileReload" Command="{x:Bind ViewModel.ReloadPublicProfileCommand}"
                                        IsEnabled="{x:Bind ViewModel.SelectedPublicChat.IsProfileBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="PublicMediaExpander" l:Uids.Uid="GlobalProfileMedia" Expanding="OnPublicMediaExpanding"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <ProgressBar IsIndeterminate="True"
                                             Visibility="{x:Bind ViewModel.SelectedPublicChat.IsMediaBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock l:Uids.Uid="GlobalProfileMediaHint" Style="{StaticResource ChatSecondary}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedPublicChat.Media, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:TgPublicChatMediaRow">
                                            <Grid Padding="0,6" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Caption, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Count}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{x:Bind ViewModel.SelectedPublicChat.MediaError, Mode=OneWay}" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <Button l:Uids.Uid="GlobalProfileReloadMedia" Command="{x:Bind ViewModel.ReloadPublicMediaCommand}"
                                        IsEnabled="{x:Bind ViewModel.SelectedPublicChat.IsMediaBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
                            </StackPanel>
                        </Expander>
                        <TextBlock l:Uids.Uid="GlobalSearchPreviewHint" Style="{StaticResource ChatSecondary}" />
                        <Button Content="{x:Bind ViewModel.PublicChatActionCaption, Mode=OneWay}"
                                Command="{x:Bind ViewModel.AddPublicChatCommand}" Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="PublicChatAdd" />
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.IsLocalSearch, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            <Grid Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:DataGrid
                    x:Name="DataGridChats"
                    AutoGenerateColumns="False"
                    AutomationProperties.AutomationId="ChatsRegistry"
                    Background="Transparent"
                    BorderThickness="0"
                    CanUserSortColumns="False"
                    ColumnHeaderStyle="{StaticResource RegistryHeader}"
                    DoubleTapped="{x:Bind ViewModel.DataGrid_DoubleTapped}"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{x:Bind ViewModel.RegistryRows, Mode=OneWay}"
                    LoadingRow="OnRegistryRowLoading"
                    RightTapped="OnChatRightTapped"
                    RowHeight="64"
                    SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}">
                    <controls:DataGrid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="ChatRowParsing"
                                Command="{x:Bind ViewModel.ToggleSelectedParsingCommand}"
                                Text="{x:Bind ViewModel.ParsingCaption, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="{x:Bind ViewModel.ParsingGlyph, Mode=OneWay}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="ChatRowPause"
                                Command="{x:Bind ViewModel.PauseSelectedCommand}"
                                Text="{x:Bind ViewModel.PauseCaption, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE769;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </controls:DataGrid.ContextFlyout>
                    <controls:DataGrid.Columns>
                        <controls:DataGridTemplateColumn
                            Width="3*"
                            MinWidth="180"
                            CellTemplate="{StaticResource RegistryIdentity}"
                            Header="{x:Bind ViewModel.ChatTitleHeader, Mode=OneWay}" />
                        <controls:DataGridTextColumn
                            Width="Auto"
                            MinWidth="100"
                            Binding="{Binding MessagesText}"
                            Header="{x:Bind ViewModel.ChatCountHeader, Mode=OneWay}" />
                        <controls:DataGridTextColumn
                            Width="Auto"
                            MinWidth="75"
                            Binding="{Binding DirectorySizeText}"
                            Header="{x:Bind ViewModel.ChatSizeHeader, Mode=OneWay}" />
                        <controls:DataGridTemplateColumn
                            Width="2*"
                            MinWidth="190"
                            CellTemplate="{StaticResource RegistryProgress}"
                            Header="{x:Bind ViewModel.ChatProgressHeader, Mode=OneWay}" />
                        <controls:DataGridTextColumn
                            x:Name="UpdatedColumn"
                            Width="160"
                            Binding="{Binding Updated}"
                            Header="{x:Bind ViewModel.ChatUpdatedHeader, Mode=OneWay}" />
                    </controls:DataGrid.Columns>
                </controls:DataGrid>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    l:Uids.Uid="RegistryEmpty"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.IsEmptyData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Grid>
        <Grid Grid.Row="3" ColumnSpacing="12" Visibility="{x:Bind ViewModel.IsLocalSearch, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                l:Uids.Uid="RegistryHint"
                Style="{StaticResource ChatSecondary}" />
        </Grid>
        <!--  Действия и сведения относятся только к выбранной строке  -->
        <Grid Grid.Row="4" Visibility="{x:Bind ViewModel.IsLocalSearch, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
        <Border
            AutomationProperties.AutomationId="ChatSelectionActions"
            Style="{StaticResource ChatSurface}"
            Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Spacing="10">
                <TextBlock
                    MaxLines="2"
                    Style="{StaticResource ChatTitle}"
                    Text="{x:Bind ViewModel.SelectedRow.Title, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource ChatSecondary}" Text="{x:Bind ViewModel.SelectionDetails, Mode=OneWay}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        l:Uids.Uid="RegistryDelete"
                        Command="{x:Bind ViewModel.DeleteChatCommand}"
                        CommandParameter="{x:Bind ViewModel.SelectedRow.Source, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsOnlineProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                        <FontIcon Glyph="&#xE74D;" />
                    </Button>
                    <Button
                        Grid.Column="1"
                        AutomationProperties.AutomationId="ChatRegistryParsing"
                        Command="{x:Bind ViewModel.ToggleSelectedParsingCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind ViewModel.ParsingGlyph, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.ParsingCaption, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="2"
                        AutomationProperties.AutomationId="ChatRegistryPause"
                        Command="{x:Bind ViewModel.PauseSelectedCommand}"
                        IsEnabled="{x:Bind ViewModel.CanPauseSelected, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE769;" />
                            <TextBlock Text="{x:Bind ViewModel.PauseCaption, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="3"
                        AutomationProperties.AutomationId="ChatOpenChat"
                        Command="{x:Bind ViewModel.OpenSelectedChatCommand}"
                        IsEnabled="{x:Bind ViewModel.HasSelectedChat, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEA5B;" />
                            <TextBlock l:Uids.Uid="RegistryOpenChat" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    l:Uids.Uid="RegistryDetails">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource ChatSecondary}" Text="{x:Bind ViewModel.SelectedRow.Identity, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource ChatSecondary}"
                            Text="{x:Bind ViewModel.SelectedRow.Directory, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource ChatSecondary}" Text="{x:Bind ViewModel.SelectedRow.Updated, Mode=OneWay}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</common:TgPageBase>
