<common:TgPageBase
    x:Class="OpenTgResearcherDesktop.Views.TgProxiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:OpenTgResearcherDesktop.Common"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:OpenTgResearcherDesktop.Helpers"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:proxies="using:TgStorage.Domain.Proxies"
    xmlns:styles="using:OpenTgResearcherDesktop.Styles"
    xmlns:viewmodels="using:OpenTgResearcherDesktop.ViewModels"
    xmlns:views="using:OpenTgResearcherDesktop.Views"
    d:DataContext="{d:DesignInstance Type=viewmodels:TgProxiesViewModel}"
    mc:Ignorable="d">

    <ScrollView VerticalScrollMode="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <!--  Действия со списком прокси  -->
            <Expander
                Margin="{StaticResource ExpanderMargin}"
                Padding="{StaticResource ExpanderPadding}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                l:Uids.Uid="ExpanderActions"
                IsEnabled="{x:Bind ViewModel.IsStorageProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                IsExpanded="True">
                <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.IsCheckingProxies, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.AddProxyCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" />
                                <TextBlock VerticalAlignment="Center" l:Uids.Uid="ActionCreate" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.CreateDefaultProxyCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE777;" />
                                <TextBlock VerticalAlignment="Center" l:Uids.Uid="ActionCreateDefault" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.LoadDataStorageCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" />
                                <TextBlock VerticalAlignment="Center" l:Uids.Uid="ActionLoadFromStorage" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Row="0"
                            Grid.Column="3"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.DefaultSortCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8CB;" />
                                <TextBlock VerticalAlignment="Center" l:Uids.Uid="TextBlockDefaultSort" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Row="1"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.OpenOrEditProxyCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEA5B;" />
                                <TextBlock VerticalAlignment="Center" l:Uids.Uid="ActionOpenOrEdit" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.DeleteProxyCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE894;" />
                                <TextBlock VerticalAlignment="Center" l:Uids.Uid="ActionDelete" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Row="1"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.DeleteAllProxiesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" />
                                <TextBlock VerticalAlignment="Center" l:Uids.Uid="ActionDeleteAll" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Row="1"
                            Grid.Column="3"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.ClearViewCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE894;" />
                                <TextBlock VerticalAlignment="Center" l:Uids.Uid="ActionClearView" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.CheckAllProxiesCommand}">
                            <TextBlock l:Uids.Uid="ProxyCheckAllAction" />
                        </Button>
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="2"
                            Grid.ColumnSpan="2"
                            l:Uids.Uid="ProxyCheckHelp"
                            TextWrapping="Wrap" />
                        <!--  Импорт из локальных настроек Telegram Desktop  -->
                        <Grid
                            Grid.Row="3"
                            Grid.ColumnSpan="4"
                            ColumnSpacing="8"
                            RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.ColumnSpan="2"
                                l:Uids.Uid="TelegramProxyImportHelp"
                                TextWrapping="Wrap" />
                            <TextBox
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                l:Uids.Uid="TelegramDataDirectory"
                                Text="{x:Bind ViewModel.TelegramDataPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Row="1"
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.ImportTelegramProxiesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B5;" />
                                    <TextBlock l:Uids.Uid="TelegramProxyImportAction" />
                                </StackPanel>
                            </Button>
                            <TextBlock
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.ImportResult, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>
                        <StackPanel
                            Grid.Row="4"
                            Grid.ColumnSpan="4"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock l:Uids.Uid="TextBlockCount" />
                            <TextBlock Text="{x:Bind ViewModel.Dtos.Count, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </ContentControl>
            </Expander>
            <InfoBar
                Grid.Row="1"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.Exception.IsExist, Mode=OneWay}"
                Message="{x:Bind ViewModel.Exception.Message, Mode=OneWay}"
                Severity="Error" />
            <!--  Сохранённые прокси и результаты проверки доступности  -->
            <ContentControl
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsStorageProcessing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Expander
                    Grid.Row="0"
                    Margin="{StaticResource ExpanderMargin}"
                    Padding="{StaticResource ExpanderPadding}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    l:Uids.Uid="ExpanderDataInStorage"
                    IsExpanded="True">
                    <Grid Margin="0,0,10,0">
                        <controls:DataGrid
                            x:Name="DataGridProxies"
                            Margin="0,0,10,0"
                            VerticalAlignment="Top"
                            AutoGenerateColumns="False"
                            Background="Transparent"
                            CanUserSortColumns="False"
                            DoubleTapped="{x:Bind ViewModel.DataGrid_DoubleTapped, Mode=OneWay}"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{x:Bind ViewModel.Dtos, Mode=OneWay}"
                            RightTapped="OnProxyRightTapped"
                            SelectedItem="{x:Bind ViewModel.SelectedProxy, Mode=TwoWay}"
                            SelectionMode="Single">
                            <controls:DataGrid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        l:Uids.Uid="ProxyApplyAction"
                                        Command="{x:Bind ViewModel.ApplyProxyCommand}"
                                        Text="Применить прокси" />
                                </MenuFlyout>
                            </controls:DataGrid.ContextFlyout>
                            <controls:DataGrid.Columns>
                                <!--  Тип прокси  -->
                                <styles:TgBindableDataGridTemplateColumn Header="{x:Bind ViewModel.ProxyTypeHeader}"
                                    ColumnSensitive="{StaticResource ColumnSensitiveTemplate}"
                                    ColumnValue="{StaticResource ColumnTypeTemplate}"
                                    ColumnVisible="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay}"
                                    ColumnWidth="Auto"
                                    OwnerGrid="{x:Bind DataGridProxies}" />
                                <!--  Сервер  -->
                                <styles:TgBindableDataGridTemplateColumn Header="{x:Bind ViewModel.ProxyHostHeader}"
                                    ColumnSensitive="{StaticResource ColumnSensitiveTemplate}"
                                    ColumnValue="{StaticResource ColumnHostNameTemplate}"
                                    ColumnVisible="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay}"
                                    ColumnWidth="1*"
                                    OwnerGrid="{x:Bind DataGridProxies}" />
                                <!--  Порт  -->
                                <styles:TgBindableDataGridTemplateColumn Header="{x:Bind ViewModel.ProxyPortHeader}"
                                    ColumnSensitive="{StaticResource ColumnSensitiveTemplate}"
                                    ColumnValue="{StaticResource ColumnPortTemplate}"
                                    ColumnVisible="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay}"
                                    ColumnWidth="Auto"
                                    OwnerGrid="{x:Bind DataGridProxies}" />
                                <!--  Пользователь  -->
                                <styles:TgBindableDataGridTemplateColumn Header="{x:Bind ViewModel.ProxyUserHeader}"
                                    ColumnSensitive="{StaticResource ColumnSensitiveTemplate}"
                                    ColumnValue="{StaticResource ColumnUserNameTemplate}"
                                    ColumnVisible="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay}"
                                    ColumnWidth="Auto"
                                    OwnerGrid="{x:Bind DataGridProxies}" />
                                <!--  Пароль  -->
                                <styles:TgBindableDataGridTemplateColumn Header="{x:Bind ViewModel.ProxyPasswordHeader}"
                                    ColumnSensitive="{StaticResource ColumnSensitiveTemplate}"
                                    ColumnValue="{StaticResource ColumnPasswordTemplate}"
                                    ColumnVisible="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay}"
                                    ColumnWidth="Auto"
                                    OwnerGrid="{x:Bind DataGridProxies}" />
                                <!--  Проверка сервера и порта без входа в Telegram  -->
                                <controls:DataGridTextColumn Header="{x:Bind ViewModel.ProxyAvailabilityHeader}" Width="Auto" Binding="{Binding AvailabilityStatus, Mode=OneWay}" />
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                    </Grid>
                </Expander>
            </ContentControl>
        </Grid>
    </ScrollView>
</common:TgPageBase>
