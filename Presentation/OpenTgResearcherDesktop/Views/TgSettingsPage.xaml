<common:TgPageBase
    x:Class="OpenTgResearcherDesktop.Views.TgSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:OpenTgResearcherDesktop.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:styles="using:OpenTgResearcherDesktop.Styles"
    xmlns:viewmodels="using:OpenTgResearcherDesktop.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:TgSettingsViewModel}"
    mc:Ignorable="d">
    <common:TgPageBase.Resources>
        <Style x:Key="SettingsSectionStyle" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </common:TgPageBase.Resources>
    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  Действия закреплены над прокруткой и остаются доступны из любой секции  -->
        <StackPanel x:Name="SettingsHeader" Spacing="4">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    l:Uids.Uid="SettingsTitle"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6">
                    <!--  Загрузка сохранённых настроек  -->
                    <Button
                        MinHeight="34"
                        Padding="10,4"
                        Command="{x:Bind ViewModel.SettingsLoadCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE896;" />
                            <TextBlock VerticalAlignment="Center" l:Uids.Uid="ActionLoad" />
                        </StackPanel>
                    </Button>
                    <!--  Сброс черновика без немедленного сохранения  -->
                    <Button
                        MinHeight="34"
                        Padding="10,4"
                        l:Uids.Uid="SettingsReset"
                        Command="{x:Bind ViewModel.SettingsDefaultCommand}" />
                    <!--  Единое сохранение параметров приложения, файлов и предварительных выпусков  -->
                    <Button
                        MinHeight="34"
                        Padding="12,4"
                        Command="{x:Bind ViewModel.SettingsSaveCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE74E;" />
                            <TextBlock VerticalAlignment="Center" l:Uids.Uid="ActionSave" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <TextBlock
                FontSize="12"
                IsTextSelectionEnabled="True"
                Text="{x:Bind ViewModel.PreferencesMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer
            x:Name="SettingsScroll"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <!--  Приложение: язык и тема расположены рядом, вторичные пояснения доступны в подсказке  -->
                <Expander
                    l:Uids.Uid="ExpanderSettingApp"
                    IsExpanded="True"
                    Style="{StaticResource SettingsSectionStyle}">
                    <StackPanel Margin="12" Spacing="8">
                        <Grid ColumnSpacing="16" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!--  Значок и поле языка используют общий ресурс перевода  -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <styles:TgOutlineIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="language" />
                                <TextBlock
                                    x:Name="LanguageLabel"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    l:Uids.Uid="ProgramLanguage" />
                                <ComboBox
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.LabeledBy="{x:Bind LanguageLabel}"
                                    SelectedIndex="{x:Bind ViewModel.Preferences.LanguageIndex, Mode=TwoWay}">
                                    <ComboBoxItem l:Uids.Uid="ProgramSystemLanguage" />
                                    <ComboBoxItem Content="English" />
                                    <ComboBoxItem Content="Русский" />
                                </ComboBox>
                            </Grid>
                            <!--  Значок и поле темы используют общий ресурс оформления  -->
                            <Grid Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <styles:TgOutlineIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="theme" />
                                <TextBlock
                                    x:Name="ThemeLabel"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    l:Uids.Uid="ProgramTheme" />
                                <ComboBox
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.LabeledBy="{x:Bind ThemeLabel}"
                                    SelectedIndex="{x:Bind ViewModel.Preferences.ThemeIndex, Mode=TwoWay}">
                                    <ComboBoxItem l:Uids.Uid="ProgramDefaultTheme" />
                                    <ComboBoxItem l:Uids.Uid="ProgramLightTheme" />
                                    <ComboBoxItem l:Uids.Uid="ProgramDarkTheme" />
                                </ComboBox>
                            </Grid>
                            <CheckBox
                                Grid.Row="1"
                                MinHeight="30"
                                l:Uids.Uid="ProgramAutoStart"
                                IsChecked="{x:Bind ViewModel.Preferences.AutoStart, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.CanConfigureAutoStart}" />
                        </Grid>
                        <!--  Цвет акцента занимает одну строку  -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                MinHeight="32"
                                VerticalAlignment="Center"
                                l:Uids.Uid="ProgramSystemAccent"
                                IsChecked="{x:Bind ViewModel.Preferences.UseSystemAccent, Mode=TwoWay}" />
                            <TextBlock
                                x:Name="AccentLabel"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                l:Uids.Uid="ProgramAccent" />
                            <TextBox
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.LabeledBy="{x:Bind AccentLabel}"
                                IsEnabled="{x:Bind ViewModel.Preferences.UseSystemAccent, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                MaxLength="7"
                                Text="{x:Bind ViewModel.Preferences.AccentHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                l:Uids.Uid="ProgramPickAccent"
                                IsEnabled="{x:Bind ViewModel.Preferences.UseSystemAccent, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                                <Button.Flyout>
                                    <Flyout Opening="AccentFlyout_Opening">
                                        <ColorPicker
                                            x:Name="AccentPicker"
                                            ColorChanged="AccentPicker_ColorChanged"
                                            IsAlphaEnabled="False"
                                            IsAlphaSliderVisible="False"
                                            IsAlphaTextInputVisible="False" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Expander>
                <!--  Обновления используют ту же модель и журнал, что и кнопка верхней панели  -->
                <Expander
                    x:Name="UpdatesSection"
                    l:Uids.Uid="SettingsUpdates"
                    IsExpanded="{x:Bind ViewModel.IsUpdatesExpanded, Mode=TwoWay}"
                    Style="{StaticResource SettingsSectionStyle}">
                    <StackPanel Margin="12" Spacing="8">
                        <TextBlock
                            l:Uids.Uid="ProgramUpdateHint"
                            FontSize="12"
                            Opacity="0.7"
                            TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                MinHeight="34"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="UpdateRelease"
                                Command="{x:Bind ViewModel.Updates.UpdateReleaseCommand}">
                                <TextBlock l:Uids.Uid="ActionUpdateReleaseApp" TextWrapping="Wrap" />
                            </Button>
                            <Button
                                Grid.Column="1"
                                MinHeight="34"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="UpdatePreview"
                                Command="{x:Bind ViewModel.Updates.UpdatePreviewCommand}">
                                <TextBlock l:Uids.Uid="ActionUpdatePreviewApp" TextWrapping="Wrap" />
                            </Button>
                        </Grid>
                        <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.Updates.IsUpdating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar
                                VerticalAlignment="Center"
                                IsIndeterminate="{x:Bind ViewModel.Updates.IsDownloading, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                Maximum="100"
                                Minimum="0"
                                Value="{x:Bind ViewModel.Updates.DownloadProgress, Mode=OneWay}" />
                            <Button
                                Grid.Column="1"
                                l:Uids.Uid="ActionCancelUpdate"
                                Command="{x:Bind ViewModel.Updates.CancelUpdateCommand}" />
                        </Grid>
                        <TextBlock l:Uids.Uid="UpdateLogCaption" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBox
                            MinHeight="96"
                            MaxHeight="180"
                            AcceptsReturn="True"
                            AutomationProperties.AutomationId="UpdateLog"
                            IsReadOnly="True"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Text="{x:Bind ViewModel.Updates.UpdateLog, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
                <!--  Профиль объединяет базу и сессию аккаунта, применение выполняет штатный перезапуск  -->
                <Expander
                    x:Name="SettingsFilesSection"
                    l:Uids.Uid="SettingRecording"
                    IsEnabled="{x:Bind ViewModel.IsProfileBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                    IsExpanded="False"
                    Style="{StaticResource SettingsSectionStyle}">
                    <StackPanel Margin="12" Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="ProfileSelector"
                                DisplayMemberPath="Name"
                                IsEnabled="{x:Bind ViewModel.CanSelectProfile, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.Profiles}"
                                SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}" />
                            <Button
                                Grid.Column="1"
                                l:Uids.Uid="ProfileCreate"
                                Command="{x:Bind ViewModel.ProfileCreateCommand}" />
                            <Button
                                Grid.Column="2"
                                l:Uids.Uid="ProfileEdit"
                                Command="{x:Bind ViewModel.ProfileEditCommand}" />
                            <Button
                                Grid.Column="3"
                                l:Uids.Uid="ProfileDelete"
                                Command="{x:Bind ViewModel.ProfileDeleteCommand}" />
                        </Grid>
                        <!--  Режим просмотра объясняет блокировку полей и способ начать редактирование  -->
                        <Border
                            Padding="12,8"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Visibility="{x:Bind ViewModel.IsProfileEditing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE72E;" />
                                    <TextBlock l:Uids.Uid="ProfileViewMode" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock
                                    l:Uids.Uid="ProfileViewHint"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <!--  Акцентная рамка и отдельные действия обозначают редактируемый черновик  -->
                        <Border
                            Padding="12,8"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource SystemControlForegroundAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{x:Bind ViewModel.IsProfileEditing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                                        Glyph="&#xE70F;" />
                                    <TextBlock l:Uids.Uid="ProfileEditMode" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock
                                    l:Uids.Uid="ProfileEditHint"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    l:Uids.Uid="ProfileSensitiveEditHint"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                        <TextBox
                            l:Uids.Uid="ProfileName"
                            AutomationProperties.AutomationId="ProfileName"
                            IsReadOnly="{x:Bind ViewModel.IsProfileEditing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                            Text="{x:Bind ViewModel.SelectedProfile.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <!--  Хранилище выбранного профиля без изменения открытой базы до применения  -->
                        <TextBlock l:Uids.Uid="SettingStorage" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <!--  Конфиденциальные данные  -->
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            <TextBox
                                AutomationProperties.AutomationId="ProfileStorage"
                                FontSize="13"
                                IsReadOnly="{x:Bind ViewModel.IsProfileEditing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                Text="{x:Bind ViewModel.SelectedProfile.StoragePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <styles:TgAnimatedClipboardButton
                                Grid.Column="1"
                                Click="OnClipboardSilentWriteClick"
                                Style="{StaticResource ClipboardAnimatedButtonStyle}"
                                Tag="{x:Bind ViewModel.SelectedProfile.StoragePath, Mode=OneWay}" />
                        </Grid>
                        <!--  Файл сессии Telegram  -->
                        <TextBlock l:Uids.Uid="SettingSession" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <!--  Конфиденциальные данные  -->
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            <TextBox
                                AutomationProperties.AutomationId="ProfileSession"
                                FontSize="13"
                                IsReadOnly="{x:Bind ViewModel.IsProfileEditing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                Text="{x:Bind ViewModel.SelectedProfile.SessionPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <styles:TgAnimatedClipboardButton
                                Grid.Column="1"
                                Click="OnClipboardSilentWriteClick"
                                Style="{StaticResource ClipboardAnimatedButtonStyle}"
                                Tag="{x:Bind ViewModel.SelectedProfile.SessionPath, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            l:Uids.Uid="ProfileUsageHint"
                            FontSize="12"
                            Opacity="0.7"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="12"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.ProfileMessage, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Right"
                            l:Uids.Uid="ProfileApply"
                            Command="{x:Bind ViewModel.ProfileApplyCommand}"
                            Visibility="{x:Bind ViewModel.IsProfileEditing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.IsProfileEditing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button l:Uids.Uid="ProfileCancelEdit" Command="{x:Bind ViewModel.ProfileCancelEditCommand}" />
                            <Button
                                l:Uids.Uid="ProfileSave"
                                Command="{x:Bind ViewModel.ProfileSaveCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                        <!--  Предупреждения о файлах доступны отдельно от редактируемых полей  -->
                        <Expander
                            l:Uids.Uid="SettingsFileWarning"
                            IsExpanded="False"
                            Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel Margin="8" Spacing="4">
                                <TextBlock
                                    l:Uids.Uid="FieldSettingsFileWarning1"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    l:Uids.Uid="FieldSettingsFileWarning2"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    l:Uids.Uid="FieldSettingsFileWarning3"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Expander>
                <!--  Каталоги и файл настроек показаны компактными строками только при раскрытии  -->
                <Expander
                    x:Name="SettingsDetailsSection"
                    l:Uids.Uid="SettingsDetails"
                    IsExpanded="False"
                    Style="{StaticResource SettingsSectionStyle}">
                    <Grid
                        Margin="12"
                        ColumnSpacing="12"
                        RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!--  Каталог пользователя  -->
                        <TextBlock
                            VerticalAlignment="Center"
                            l:Uids.Uid="SettingUserDirectory"
                            FontSize="12" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{x:Bind ViewModel.UserDirectory, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <styles:TgAnimatedClipboardButton
                            Grid.Column="2"
                            Click="OnClipboardSilentWriteClick"
                            Style="{StaticResource ClipboardAnimatedButtonStyle}"
                            Tag="{x:Bind ViewModel.UserDirectory, Mode=OneWay}" />
                        <!--  Файл настроек  -->
                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            l:Uids.Uid="SettingFile"
                            FontSize="12" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{x:Bind ViewModel.SettingsService.SettingFile, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <styles:TgAnimatedClipboardButton
                            Grid.Row="1"
                            Grid.Column="2"
                            Click="OnClipboardSilentWriteClick"
                            Style="{StaticResource ClipboardAnimatedButtonStyle}"
                            Tag="{x:Bind ViewModel.SettingsService.SettingFile, Mode=OneWay}" />
                        <!--  Каталог приложения  -->
                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            l:Uids.Uid="SettingAppDirectory"
                            FontSize="12" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{x:Bind ViewModel.SettingsService.ApplicationDirectory, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <styles:TgAnimatedClipboardButton
                            Grid.Row="2"
                            Grid.Column="2"
                            Click="OnClipboardSilentWriteClick"
                            Style="{StaticResource ClipboardAnimatedButtonStyle}"
                            Tag="{x:Bind ViewModel.SettingsService.ApplicationDirectory, Mode=OneWay}" />
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</common:TgPageBase>
