<common:TgPageBase
    x:Class="OpenTgResearcherDesktop.Views.TgSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:OpenTgResearcherDesktop.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:OpenTgResearcherDesktop.Helpers"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:styles="using:OpenTgResearcherDesktop.Styles"
    xmlns:viewmodels="using:OpenTgResearcherDesktop.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:TgSettingsViewModel}"
    mc:Ignorable="d">

    <ScrollView VerticalScrollMode="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <!--  Действия  -->
            <Expander
                Grid.Row="0"
                Margin="{StaticResource ExpanderMargin}"
                Padding="{StaticResource ExpanderPadding}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                l:Uids.Uid="ExpanderActions"
                IsExpanded="True">
                <Grid Margin="0,-10,0,-10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--  Кнопка загрузки настроек  -->
                    <Button
                        Margin="0,0,5,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Command="{x:Bind Path=ViewModel.SettingsLoadCommand}">
                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                            <FontIcon Margin="10,0,20,0" Glyph="&#xE896;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                l:Uids.Uid="ActionLoad" />
                        </StackPanel>
                    </Button>
                    <!--  Кнопка сброса настроек  -->
                    <Button
                        Grid.Column="1"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Command="{x:Bind Path=ViewModel.SettingsDefaultCommand}">
                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                            <FontIcon Margin="10,0,20,0" Glyph="&#xE72C;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                l:Uids.Uid="ActionResetToDefault" />
                        </StackPanel>
                    </Button>
                    <!--  Кнопка сохранения  -->
                    <Button
                        Grid.Column="2"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Command="{x:Bind Path=ViewModel.SettingsSaveCommand}">
                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                            <FontIcon Margin="10,0,20,0" Glyph="&#xE74E;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                l:Uids.Uid="ActionSave" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Expander>
            <!--  Приложение  -->
            <Expander
                Grid.Row="1"
                Margin="{StaticResource ExpanderMargin}"
                Padding="{StaticResource ExpanderPadding}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                l:Uids.Uid="ExpanderSettingApp"
                IsExpanded="True">
                <StackPanel Spacing="16" Margin="8">
                    <TextBlock Text="{x:Bind ViewModel.PreferencesMessage, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <!--  Значок и поле языка используют общие ресурсы приложения  -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <styles:TgOutlineIcon Width="20" Height="20" Kind="language" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" l:Uids.Uid="ProgramLanguage" HorizontalAlignment="Stretch"
                                  SelectedIndex="{x:Bind ViewModel.Preferences.LanguageIndex, Mode=TwoWay}">
                            <ComboBoxItem l:Uids.Uid="ProgramSystemLanguage" />
                            <ComboBoxItem Content="English" />
                            <ComboBoxItem Content="Русский" />
                        </ComboBox>
                    </Grid>
                    <CheckBox l:Uids.Uid="ProgramAutoStart" IsEnabled="{x:Bind ViewModel.CanConfigureAutoStart}"
                              IsChecked="{x:Bind ViewModel.Preferences.AutoStart, Mode=TwoWay}" />
                    <TextBlock l:Uids.Uid="ProgramAutoStartHint" Opacity="0.7" TextWrapping="Wrap" />
                    <CheckBox l:Uids.Uid="ProgramSystemTheme" IsChecked="{x:Bind ViewModel.Preferences.UseSystemTheme, Mode=TwoWay}" />
                    <!--  Значок и поле темы используют общие ресурсы приложения  -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <styles:TgOutlineIcon Width="20" Height="20" Kind="theme" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" l:Uids.Uid="ProgramTheme" HorizontalAlignment="Stretch"
                                  IsEnabled="{x:Bind ViewModel.Preferences.UseSystemTheme, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                  SelectedIndex="{x:Bind ViewModel.Preferences.ThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem l:Uids.Uid="ProgramLightTheme" />
                            <ComboBoxItem l:Uids.Uid="ProgramDarkTheme" />
                        </ComboBox>
                    </Grid>
                    <CheckBox l:Uids.Uid="ProgramSystemAccent" IsChecked="{x:Bind ViewModel.Preferences.UseSystemAccent, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBox Width="160" MaxLength="7" l:Uids.Uid="ProgramAccent"
                                 IsEnabled="{x:Bind ViewModel.Preferences.UseSystemAccent, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                 Text="{x:Bind ViewModel.Preferences.AccentHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button l:Uids.Uid="ProgramPickAccent" VerticalAlignment="Bottom"
                                IsEnabled="{x:Bind ViewModel.Preferences.UseSystemAccent, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                            <Button.Flyout>
                                <Flyout Opening="AccentFlyout_Opening">
                                    <ColorPicker x:Name="AccentPicker" IsAlphaEnabled="False" IsAlphaSliderVisible="False"
                                                 IsAlphaTextInputVisible="False" ColorChanged="AccentPicker_ColorChanged" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Expander>
            <!--  Настройки только для чтения  -->
            <Expander
                Grid.Row="2"
                Margin="{StaticResource ExpanderMargin}"
                Padding="{StaticResource ExpanderPadding}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                l:Uids.Uid="SettingReadOnly"
                IsExpanded="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  Каталог пользователя  -->
                    <TextBlock
                        Margin="10,5,10,5"
                        l:Uids.Uid="SettingUserDirectory"
                        TextAlignment="Left" />
                    <!--  Конфиденциальные данные  -->
                    <TextBlock
                        Grid.Column="2"
                        Margin="5"
                        Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="15,5,5,5"
                        HorizontalAlignment="Stretch"
                        Text="{x:Bind ViewModel.UserDirectory, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <styles:TgAnimatedClipboardButton
                        Grid.Column="3"
                        Click="OnClipboardSilentWriteClick"
                        Style="{StaticResource ClipboardAnimatedButtonStyle}"
                        Tag="{x:Bind ViewModel.UserDirectory, Mode=OneWay}" />
                    <!--  Файл настроек  -->
                    <TextBlock
                        Grid.Row="1"
                        Margin="10,5,10,5"
                        l:Uids.Uid="SettingFile"
                        TextAlignment="Left" />
                    <!--  Конфиденциальные данные  -->
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="5"
                        Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="15,5,5,5"
                        HorizontalAlignment="Stretch"
                        Text="{x:Bind ViewModel.SettingsService.SettingFile, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <styles:TgAnimatedClipboardButton
                        Grid.Row="1"
                        Grid.Column="3"
                        Click="OnClipboardSilentWriteClick"
                        Style="{StaticResource ClipboardAnimatedButtonStyle}"
                        Tag="{x:Bind ViewModel.SettingsService.SettingFile, Mode=OneWay}" />
                    <!--  Каталог приложения  -->
                    <TextBlock
                        Grid.Row="2"
                        Margin="10,5,10,5"
                        l:Uids.Uid="SettingAppDirectory"
                        TextAlignment="Left" />
                    <!--  Конфиденциальные данные  -->
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="5"
                        Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="15,5,5,5"
                        HorizontalAlignment="Stretch"
                        Text="{x:Bind ViewModel.SettingsService.ApplicationDirectory, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <styles:TgAnimatedClipboardButton
                        Grid.Row="2"
                        Grid.Column="3"
                        Click="OnClipboardSilentWriteClick"
                        Style="{StaticResource ClipboardAnimatedButtonStyle}"
                        Tag="{x:Bind ViewModel.SettingsService.ApplicationDirectory, Mode=OneWay}" />
                </Grid>
            </Expander>
            <!--  Изменяемые настройки  -->
            <Expander
                Grid.Row="3"
                Margin="{StaticResource ExpanderMargin}"
                Padding="{StaticResource ExpanderPadding}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                l:Uids.Uid="SettingRecording"
                IsExpanded="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  Хранилище базы данных  -->
                    <TextBlock
                        Grid.Row="0"
                        Margin="10,5,10,5"
                        l:Uids.Uid="SettingStorage"
                        TextAlignment="Left" />
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="40"
                        Margin="5"
                        HorizontalAlignment="Center">
                        <CheckBox
                            Margin="10,0,0,0"
                            IsChecked="{x:Bind ViewModel.SettingsService.IsExistsAppStorage, Mode=OneWay}"
                            IsEnabled="False" />
                    </StackPanel>
                    <!--  Конфиденциальные данные  -->
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="5,0,0,0"
                        Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Stretch"
                        Text="{x:Bind ViewModel.SettingsService.AppStorage, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="3"
                        MinWidth="60"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.SettingsService.AppStorageFileSize, Mode=OneWay}" />
                    <styles:TgAnimatedClipboardButton
                        Grid.Row="0"
                        Grid.Column="4"
                        Click="OnClipboardSilentWriteClick"
                        Style="{StaticResource ClipboardAnimatedButtonStyle}"
                        Tag="{x:Bind ViewModel.SettingsService.AppStorage, Mode=OneWay}" />
                    <!--  Сессия  -->
                    <TextBlock
                        Grid.Row="1"
                        Margin="10,5,10,5"
                        l:Uids.Uid="SettingSession"
                        TextAlignment="Left" />
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="40"
                        Margin="5"
                        HorizontalAlignment="Center">
                        <CheckBox
                            Margin="10,0,0,0"
                            IsChecked="{x:Bind ViewModel.SettingsService.IsExistsAppSession, Mode=OneWay}"
                            IsEnabled="False" />
                    </StackPanel>
                    <!--  Конфиденциальные данные  -->
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="5,0,0,0"
                        Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Stretch"
                        Text="{x:Bind ViewModel.SettingsService.AppSession, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="3"
                        MinWidth="60"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.SettingsService.AppSessionFileSize, Mode=OneWay}" />
                    <styles:TgAnimatedClipboardButton
                        Grid.Row="1"
                        Grid.Column="4"
                        Click="OnClipboardSilentWriteClick"
                        Style="{StaticResource ClipboardAnimatedButtonStyle}"
                        Tag="{x:Bind ViewModel.SettingsService.AppSession, Mode=OneWay}" />
                    <!--  Предупреждение  -->
                    <FontIcon
                        Grid.Row="2"
                        Grid.RowSpan="3"
                        Grid.Column="1"
                        Glyph="&#xE7BA;" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="5,0,0,0"
                        VerticalAlignment="Stretch"
                        l:Uids.Uid="FieldSettingsFileWarning1"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="2"
                        Margin="5,0,0,0"
                        VerticalAlignment="Stretch"
                        l:Uids.Uid="FieldSettingsFileWarning2"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="2"
                        Margin="5,0,0,0"
                        VerticalAlignment="Stretch"
                        l:Uids.Uid="FieldSettingsFileWarning3"
                        TextWrapping="WrapWholeWords" />
                </Grid>
            </Expander>
        </Grid>
    </ScrollView>
</common:TgPageBase>
