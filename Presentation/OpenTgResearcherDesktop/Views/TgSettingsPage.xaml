<common:TgPageBase
    x:Class="OpenTgResearcherDesktop.Views.TgSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:OpenTgResearcherDesktop.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:styles="using:OpenTgResearcherDesktop.Styles"
    xmlns:viewmodels="using:OpenTgResearcherDesktop.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:TgSettingsViewModel}"
    mc:Ignorable="d">
    <common:TgPageBase.Resources>
        <Style x:Key="SettingsSectionStyle" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </common:TgPageBase.Resources>
    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  Действия закреплены над прокруткой и остаются доступны из любой секции  -->
        <StackPanel x:Name="SettingsHeader" Spacing="4">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock l:Uids.Uid="SettingsTitle" VerticalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <!--  Загрузка сохранённых настроек  -->
                    <Button MinHeight="34" Padding="10,4" Command="{x:Bind ViewModel.SettingsLoadCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE896;" />
                            <TextBlock l:Uids.Uid="ActionLoad" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!--  Сброс черновика без немедленного сохранения  -->
                    <Button MinHeight="34" Padding="10,4" l:Uids.Uid="SettingsReset" Command="{x:Bind ViewModel.SettingsDefaultCommand}" />
                    <!--  Единое сохранение параметров приложения, файлов и предварительных выпусков  -->
                    <Button MinHeight="34" Padding="12,4" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SettingsSaveCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE74E;" />
                            <TextBlock l:Uids.Uid="ActionSave" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.PreferencesMessage, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </StackPanel>
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
                <!--  Приложение: язык и тема расположены рядом, вторичные пояснения доступны в подсказке  -->
                <Expander l:Uids.Uid="ExpanderSettingApp" IsExpanded="True" Style="{StaticResource SettingsSectionStyle}">
                    <StackPanel Margin="12" Spacing="8">
                        <Grid ColumnSpacing="16" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!--  Значок и поле языка используют общий ресурс перевода  -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <styles:TgOutlineIcon Width="20" Height="20" Kind="language" VerticalAlignment="Center" />
                                <TextBlock x:Name="LanguageLabel" Grid.Column="1" l:Uids.Uid="ProgramLanguage" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" AutomationProperties.LabeledBy="{x:Bind LanguageLabel}"
                                          SelectedIndex="{x:Bind ViewModel.Preferences.LanguageIndex, Mode=TwoWay}">
                                    <ComboBoxItem l:Uids.Uid="ProgramSystemLanguage" />
                                    <ComboBoxItem Content="English" />
                                    <ComboBoxItem Content="Русский" />
                                </ComboBox>
                            </Grid>
                            <!--  Значок и поле темы используют общий ресурс оформления  -->
                            <Grid Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <styles:TgOutlineIcon Width="20" Height="20" Kind="theme" VerticalAlignment="Center" />
                                <TextBlock x:Name="ThemeLabel" Grid.Column="1" l:Uids.Uid="ProgramTheme" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" AutomationProperties.LabeledBy="{x:Bind ThemeLabel}"
                                    SelectedIndex="{x:Bind ViewModel.Preferences.ThemeIndex, Mode=TwoWay}">
                                    <ComboBoxItem l:Uids.Uid="ProgramDefaultTheme" />
                                    <ComboBoxItem l:Uids.Uid="ProgramLightTheme" />
                                    <ComboBoxItem l:Uids.Uid="ProgramDarkTheme" />
                                </ComboBox>
                            </Grid>
                            <CheckBox Grid.Row="1" l:Uids.Uid="ProgramAutoStart" MinHeight="30"
                                      IsEnabled="{x:Bind ViewModel.CanConfigureAutoStart}"
                                      IsChecked="{x:Bind ViewModel.Preferences.AutoStart, Mode=TwoWay}" />
                        </Grid>
                        <!--  Цвет акцента занимает одну строку  -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox l:Uids.Uid="ProgramSystemAccent" VerticalAlignment="Center" MinHeight="32"
                                      IsChecked="{x:Bind ViewModel.Preferences.UseSystemAccent, Mode=TwoWay}" />
                            <TextBlock x:Name="AccentLabel" Grid.Column="1" l:Uids.Uid="ProgramAccent" VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" MaxLength="7" VerticalAlignment="Center" AutomationProperties.LabeledBy="{x:Bind AccentLabel}"
                                IsEnabled="{x:Bind ViewModel.Preferences.UseSystemAccent, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                Text="{x:Bind ViewModel.Preferences.AccentHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="3" l:Uids.Uid="ProgramPickAccent" VerticalAlignment="Center"
                                IsEnabled="{x:Bind ViewModel.Preferences.UseSystemAccent, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                                <Button.Flyout>
                                    <Flyout Opening="AccentFlyout_Opening">
                                        <ColorPicker x:Name="AccentPicker" IsAlphaEnabled="False" IsAlphaSliderVisible="False"
                                                     IsAlphaTextInputVisible="False" ColorChanged="AccentPicker_ColorChanged" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Expander>
                <!--  Обновления используют ту же модель и журнал, что и кнопка верхней панели  -->
                <Expander x:Name="UpdatesSection" l:Uids.Uid="SettingsUpdates" Style="{StaticResource SettingsSectionStyle}"
                          IsExpanded="{x:Bind ViewModel.IsUpdatesExpanded, Mode=TwoWay}">
                    <StackPanel Margin="12" Spacing="8">
                        <TextBlock l:Uids.Uid="ProgramUpdateHint" FontSize="12" TextWrapping="Wrap" Opacity="0.7" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button HorizontalAlignment="Stretch" MinHeight="34" AutomationProperties.AutomationId="UpdateRelease"
                                    Command="{x:Bind ViewModel.Updates.UpdateReleaseCommand}">
                                <TextBlock l:Uids.Uid="ActionUpdateReleaseApp" TextWrapping="Wrap" />
                            </Button>
                            <Button Grid.Column="1" HorizontalAlignment="Stretch" MinHeight="34" AutomationProperties.AutomationId="UpdatePreview"
                                    Command="{x:Bind ViewModel.Updates.UpdatePreviewCommand}">
                                <TextBlock l:Uids.Uid="ActionUpdatePreviewApp" TextWrapping="Wrap" />
                            </Button>
                        </Grid>
                        <Grid ColumnSpacing="8"
                              Visibility="{x:Bind ViewModel.Updates.IsUpdating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar VerticalAlignment="Center" Minimum="0" Maximum="100"
                                Value="{x:Bind ViewModel.Updates.DownloadProgress, Mode=OneWay}"
                                IsIndeterminate="{x:Bind ViewModel.Updates.IsDownloading, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
                            <Button Grid.Column="1" l:Uids.Uid="ActionCancelUpdate" Command="{x:Bind ViewModel.Updates.CancelUpdateCommand}" />
                        </Grid>
                        <TextBlock l:Uids.Uid="UpdateLogCaption" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBox MinHeight="96" MaxHeight="180" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="UpdateLog" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Text="{x:Bind ViewModel.Updates.UpdateLog, Mode=OneWay}" />
                    </StackPanel>
                </Expander>
                <!--  Пути к базе и сессии доступны после раскрытия, состояние файлов и копирование сохранены  -->
                <Expander x:Name="SettingsFilesSection" l:Uids.Uid="SettingRecording" IsExpanded="False" Style="{StaticResource SettingsSectionStyle}">
                    <StackPanel Margin="12" Spacing="8">
                        <!--  Хранилище базы данных  -->
                        <TextBlock l:Uids.Uid="SettingStorage" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{x:Bind ViewModel.SettingsService.IsExistsAppStorage, Mode=OneWay}" IsEnabled="False" MinWidth="24" />
                            <!--  Конфиденциальные данные  -->
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            <TextBox Grid.Column="1" FontSize="13"
                                Text="{x:Bind ViewModel.SettingsService.AppStorage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"
                                       Text="{x:Bind ViewModel.SettingsService.AppStorageFileSize, Mode=OneWay}" />
                            <styles:TgAnimatedClipboardButton Grid.Column="3" Click="OnClipboardSilentWriteClick"
                                Style="{StaticResource ClipboardAnimatedButtonStyle}" Tag="{x:Bind ViewModel.SettingsService.AppStorage, Mode=OneWay}" />
                        </Grid>
                        <!--  Файл сессии Telegram  -->
                        <TextBlock l:Uids.Uid="SettingSession" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{x:Bind ViewModel.SettingsService.IsExistsAppSession, Mode=OneWay}" IsEnabled="False" MinWidth="24" />
                            <!--  Конфиденциальные данные  -->
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            <TextBox Grid.Column="1" FontSize="13"
                                Text="{x:Bind ViewModel.SettingsService.AppSession, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"
                                       Text="{x:Bind ViewModel.SettingsService.AppSessionFileSize, Mode=OneWay}" />
                            <styles:TgAnimatedClipboardButton Grid.Column="3" Click="OnClipboardSilentWriteClick"
                                Style="{StaticResource ClipboardAnimatedButtonStyle}" Tag="{x:Bind ViewModel.SettingsService.AppSession, Mode=OneWay}" />
                        </Grid>
                        <!--  Предупреждения о файлах доступны отдельно от редактируемых полей  -->
                        <Expander l:Uids.Uid="SettingsFileWarning" IsExpanded="False" Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel Margin="8" Spacing="4">
                                <TextBlock l:Uids.Uid="FieldSettingsFileWarning1" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock l:Uids.Uid="FieldSettingsFileWarning2" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock l:Uids.Uid="FieldSettingsFileWarning3" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Expander>
                <!--  Каталоги и файл настроек показаны компактными строками только при раскрытии  -->
                <Expander x:Name="SettingsDetailsSection" l:Uids.Uid="SettingsDetails" IsExpanded="False" Style="{StaticResource SettingsSectionStyle}">
                    <Grid Margin="12" ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!--  Каталог пользователя  -->
                        <TextBlock l:Uids.Uid="SettingUserDirectory" VerticalAlignment="Center" FontSize="12" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Text="{x:Bind ViewModel.UserDirectory, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <styles:TgAnimatedClipboardButton Grid.Column="2" Click="OnClipboardSilentWriteClick"
                            Style="{StaticResource ClipboardAnimatedButtonStyle}" Tag="{x:Bind ViewModel.UserDirectory, Mode=OneWay}" />
                        <!--  Файл настроек  -->
                        <TextBlock Grid.Row="1" l:Uids.Uid="SettingFile" VerticalAlignment="Center" FontSize="12" />
                        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontSize="12" Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                   Text="{x:Bind ViewModel.SettingsService.SettingFile, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <styles:TgAnimatedClipboardButton Grid.Row="1" Grid.Column="2" Click="OnClipboardSilentWriteClick"
                            Style="{StaticResource ClipboardAnimatedButtonStyle}" Tag="{x:Bind ViewModel.SettingsService.SettingFile, Mode=OneWay}" />
                        <!--  Каталог приложения  -->
                        <TextBlock Grid.Row="2" l:Uids.Uid="SettingAppDirectory" VerticalAlignment="Center" FontSize="12" />
                        <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontSize="12" Text="{x:Bind ViewModel.SensitiveData, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                   Text="{x:Bind ViewModel.SettingsService.ApplicationDirectory, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <styles:TgAnimatedClipboardButton Grid.Row="2" Grid.Column="2" Click="OnClipboardSilentWriteClick"
                            Style="{StaticResource ClipboardAnimatedButtonStyle}" Tag="{x:Bind ViewModel.SettingsService.ApplicationDirectory, Mode=OneWay}" />
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</common:TgPageBase>
