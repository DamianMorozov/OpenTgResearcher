<common:TgPageBase
    x:Class="OpenTgResearcherDesktop.Views.TgSplashScreenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:OpenTgResearcherDesktop.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:OpenTgResearcherDesktop.Helpers"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:styles="using:OpenTgResearcherDesktop.Styles"
    xmlns:viewmodels="using:OpenTgResearcherDesktop.ViewModels"
    mc:Ignorable="d">

    <common:TgPageBase.Resources>
        <!--  Четырёхлучевые звёздочки шлейфа используют общий рисунок и цвет акцента  -->
        <Style x:Key="SplashTrailStarStyle" TargetType="Path">
            <Setter Property="Data" Value="M 6,0 L 7.5,4.5 L 12,6 L 7.5,7.5 L 6,12 L 4.5,7.5 L 0,6 L 4.5,4.5 Z" />
            <Setter Property="Fill" Value="{ThemeResource SystemControlForegroundAccentBrush}" />
            <Setter Property="Stretch" Value="Fill" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <!--  Единые размеры карточек сохраняют положение текста и статуса каждого этапа  -->
        <Style x:Key="SplashLoadingCardStyle" TargetType="Border">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style
            x:Key="SplashLoadingTextStyle"
            BasedOn="{StaticResource BodyTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </common:TgPageBase.Resources>

    <Grid
        x:Name="MainContent"
        Padding="10"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <!--  Логотип приложения  -->
        <Grid
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Width="112"
            Height="112"
            Margin="0,8,0,16"
            HorizontalAlignment="Center">
            <!--  Неподвижный контур орбиты  -->
            <Ellipse
                Width="104"
                Height="104"
                Opacity="0.16"
                Stroke="{ThemeResource SystemControlForegroundAccentBrush}"
                StrokeThickness="2" />
            <!--  Дуга вращается, пока выполняются этапы загрузки  -->
            <Grid
                x:Name="SplashOrbit"
                Width="112"
                Height="112"
                IsHitTestVisible="False">
                <Path
                    Data="M 56,4 A 52,52 0 0 1 108,56"
                    Stroke="{ThemeResource SystemControlForegroundAccentBrush}"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="3" />
                <Ellipse
                    Width="5"
                    Height="5"
                    Margin="0,1,0,0"
                    VerticalAlignment="Top"
                    Fill="{ThemeResource SystemControlForegroundAccentBrush}" />
            </Grid>
            <ContentControl
                AutomationProperties.AutomationId="SplashLogo"
                AutomationProperties.Name="OTR"
                Style="{StaticResource TgAppLogoStyle}">
                <!--  Полоса света проходит поверх логотипа, не выходя за его область  -->
                <Border
                    x:Name="SplashScanBand"
                    Width="76"
                    Height="18"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="0.5" Color="#DDFFFFFF" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </ContentControl>
        </Grid>
        <!--  Версия приложения  -->
        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="0,0,0,30"
            HorizontalAlignment="Center"
            Style="{StaticResource TitleLargeTextBlockStyle}"
            Text="{x:Bind ViewModel.AppVersion}" />
        <!--  Загрузка: фиксированные колонки значка, названия и состояния этапа  -->
        <StackPanel
            x:Name="SplashLoadingRows"
            Grid.Row="3"
            Grid.Column="1"
            MaxWidth="560"
            Margin="0,10,0,0"
            HorizontalAlignment="Stretch"
            Spacing="6">
            <!--  Инициализация журналирования  -->
            <Border Style="{StaticResource SplashLoadingCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE729;" />
                    <TextBlock
                        Grid.Column="1"
                        l:Uids.Uid="TextBlockLoadingLogging"
                        Style="{StaticResource SplashLoadingTextStyle}" />
                    <Grid
                        Grid.Column="2"
                        Width="24"
                        AutomationProperties.AccessibilityView="Raw">
                        <Ellipse
                            Width="6"
                            Height="6"
                            Fill="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind ViewModel.IsLoadLogging, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                            Glyph="&#xE73E;"
                            Visibility="{x:Bind ViewModel.IsLoadLogging, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>
            <!--  Инициализация установщика Velopack  -->
            <Border Style="{StaticResource SplashLoadingCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE7B8;" />
                    <TextBlock
                        Grid.Column="1"
                        l:Uids.Uid="TextBlockLoadingVelopack"
                        Style="{StaticResource SplashLoadingTextStyle}" />
                    <Grid
                        Grid.Column="2"
                        Width="24"
                        AutomationProperties.AccessibilityView="Raw">
                        <Ellipse
                            Width="6"
                            Height="6"
                            Fill="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind ViewModel.IsLoadVelopack, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                            Glyph="&#xE73E;"
                            Visibility="{x:Bind ViewModel.IsLoadVelopack, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>
            <!--  Загрузка настроек  -->
            <Border Style="{StaticResource SplashLoadingCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE713;" />
                    <TextBlock
                        Grid.Column="1"
                        l:Uids.Uid="TextBlockLoadingSettings"
                        Style="{StaticResource SplashLoadingTextStyle}" />
                    <Grid
                        Grid.Column="2"
                        Width="24"
                        AutomationProperties.AccessibilityView="Raw">
                        <Ellipse
                            Width="6"
                            Height="6"
                            Fill="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind ViewModel.IsLoadSettings, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                            Glyph="&#xE73E;"
                            Visibility="{x:Bind ViewModel.IsLoadSettings, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>
            <!--  Загрузка хранилища  -->
            <Border Style="{StaticResource SplashLoadingCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xF12B;" />
                    <TextBlock
                        Grid.Column="1"
                        l:Uids.Uid="TextBlockLoadingStorage"
                        Style="{StaticResource SplashLoadingTextStyle}" />
                    <Grid
                        Grid.Column="2"
                        Width="24"
                        AutomationProperties.AccessibilityView="Raw">
                        <Ellipse
                            Width="6"
                            Height="6"
                            Fill="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind ViewModel.IsLoadStorage, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                            Glyph="&#xE73E;"
                            Visibility="{x:Bind ViewModel.IsLoadStorage, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>
            <!--  Загрузка лицензии  -->
            <Border Style="{StaticResource SplashLoadingCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8C7;" />
                    <TextBlock
                        Grid.Column="1"
                        l:Uids.Uid="TextBlockLoadingLicense"
                        Style="{StaticResource SplashLoadingTextStyle}" />
                    <Grid
                        Grid.Column="2"
                        Width="24"
                        AutomationProperties.AccessibilityView="Raw">
                        <Ellipse
                            Width="6"
                            Height="6"
                            Fill="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind ViewModel.IsLoadLicense, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                            Glyph="&#xE73E;"
                            Visibility="{x:Bind ViewModel.IsLoadLicense, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>
            <!--  Загрузка уведомлений  -->
            <Border Style="{StaticResource SplashLoadingCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xEC42;" />
                    <TextBlock
                        Grid.Column="1"
                        l:Uids.Uid="TextBlockLoadingNotifications"
                        Style="{StaticResource SplashLoadingTextStyle}" />
                    <Grid
                        Grid.Column="2"
                        Width="24"
                        AutomationProperties.AccessibilityView="Raw">
                        <Ellipse
                            Width="6"
                            Height="6"
                            Fill="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind ViewModel.IsLoadNotifications, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                            Glyph="&#xE73E;"
                            Visibility="{x:Bind ViewModel.IsLoadNotifications, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>
            <!--  Загрузка мониторинга оборудования  -->
            <Border Style="{StaticResource SplashLoadingCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE950;" />
                    <TextBlock
                        Grid.Column="1"
                        l:Uids.Uid="TextBlockLoadingHardwareResourceMonitoring"
                        Style="{StaticResource SplashLoadingTextStyle}" />
                    <Grid
                        Grid.Column="2"
                        Width="24"
                        AutomationProperties.AccessibilityView="Raw">
                        <Ellipse
                            Width="6"
                            Height="6"
                            Fill="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind ViewModel.IsLoadHardwareResourceMonitoring, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                            Glyph="&#xE73E;"
                            Visibility="{x:Bind ViewModel.IsLoadHardwareResourceMonitoring, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
        <!--  Высота области сохраняется до готовности, поэтому появление кнопки не сдвигает заставку  -->
        <Grid
            x:Name="SplashContinueHost"
            Grid.Row="5"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Height="112"
            MaxWidth="500"
            Margin="24,27,24,27"
            HorizontalAlignment="Stretch">
            <Button
                x:Name="SplashContinueButton"
                MinHeight="50"
                Margin="30"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AutomationProperties.AutomationId="SplashContinue"
                Command="{x:Bind ViewModel.ContinueCommand}"
                FontWeight="Bold"
                Visibility="{x:Bind ViewModel.IsLoadComplete, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="16">
                    <TextBlock
                        VerticalAlignment="Center"
                        l:Uids.Uid="ActionContinue"
                        Style="{StaticResource TitleTextBlockStyle}" />
                    <FontIcon VerticalAlignment="Center" Glyph="&#xF5B0;" />
                </StackPanel>
            </Button>
            <!--  Стрелка со звёздным шлейфом обходит кнопку с зазором, декоративный слой не перехватывает ввод  -->
            <Canvas AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
                <Viewbox
                    x:Name="ContinueOrbitArrow"
                    Width="14"
                    Height="14"
                    Opacity="0">
                    <Grid Width="14" Height="14">
                        <Path
                            Data="M 3,7 L 11,7 M 7,3 L 11,7 L 7,11"
                            Stroke="{ThemeResource SystemControlForegroundAccentBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.75" />
                    </Grid>
                </Viewbox>
                <Path
                    x:Name="ContinueOrbitStar1"
                    Width="10"
                    Height="10"
                    Style="{StaticResource SplashTrailStarStyle}" />
                <Path
                    x:Name="ContinueOrbitStar2"
                    Width="8"
                    Height="8"
                    Style="{StaticResource SplashTrailStarStyle}" />
                <Path
                    x:Name="ContinueOrbitStar3"
                    Width="6"
                    Height="6"
                    Style="{StaticResource SplashTrailStarStyle}" />
                <Path
                    x:Name="ContinueOrbitStar4"
                    Width="5"
                    Height="5"
                    Style="{StaticResource SplashTrailStarStyle}" />
                <Path
                    x:Name="ContinueOrbitStar5"
                    Width="4"
                    Height="4"
                    Style="{StaticResource SplashTrailStarStyle}" />
            </Canvas>
        </Grid>
        <!--  Выбор оформления доступен независимо от этапа загрузки и не сдвигает содержимое заставки  -->
        <StackPanel
            x:Name="SplashAppearanceToolbar"
            Grid.RowSpan="7"
            Grid.ColumnSpan="3"
            Margin="16,48,16,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="SplashLanguageButton"
                Height="36"
                Padding="10,0"
                l:Uids.Uid="SplashLanguage"
                AutomationProperties.AutomationId="SplashLanguage">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <styles:TgOutlineIcon
                        Width="18"
                        Height="18"
                        Kind="language" />
                    <TextBlock VerticalAlignment="Center" l:Uids.Uid="ToolbarLanguage" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout>
                        <RadioMenuFlyoutItem
                            l:Uids.Uid="ToolbarSystemLanguage"
                            Command="{x:Bind ViewModel.Appearance.ChangeLanguageCommand}"
                            CommandParameter="Default"
                            GroupName="SplashLanguages"
                            IsChecked="{x:Bind ViewModel.Appearance.IsLanguageSelected(ViewModel.SettingsService.AppLanguage, 'Default'), Mode=OneWay}" />
                        <RadioMenuFlyoutItem
                            Command="{x:Bind ViewModel.Appearance.ChangeLanguageCommand}"
                            CommandParameter="English"
                            GroupName="SplashLanguages"
                            IsChecked="{x:Bind ViewModel.Appearance.IsLanguageSelected(ViewModel.SettingsService.AppLanguage, 'English'), Mode=OneWay}"
                            Text="English" />
                        <RadioMenuFlyoutItem
                            Command="{x:Bind ViewModel.Appearance.ChangeLanguageCommand}"
                            CommandParameter="Russian"
                            GroupName="SplashLanguages"
                            IsChecked="{x:Bind ViewModel.Appearance.IsLanguageSelected(ViewModel.SettingsService.AppLanguage, 'Russian'), Mode=OneWay}"
                            Text="Русский" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button
                x:Name="SplashThemeButton"
                Height="36"
                Padding="10,0"
                l:Uids.Uid="SplashTheme"
                AutomationProperties.AutomationId="SplashTheme">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <styles:TgOutlineIcon
                        Width="18"
                        Height="18"
                        Kind="theme" />
                    <TextBlock VerticalAlignment="Center" l:Uids.Uid="ToolbarTheme" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout>
                        <RadioMenuFlyoutItem
                            l:Uids.Uid="ToolbarSystemTheme"
                            Command="{x:Bind ViewModel.Appearance.ChangeThemeCommand}"
                            CommandParameter="Default"
                            GroupName="SplashThemes"
                            IsChecked="{x:Bind ViewModel.Appearance.IsThemeSelected(ViewModel.SettingsService.AppTheme, 'Default'), Mode=OneWay}" />
                        <RadioMenuFlyoutItem
                            l:Uids.Uid="ToolbarLightTheme"
                            Command="{x:Bind ViewModel.Appearance.ChangeThemeCommand}"
                            CommandParameter="Light"
                            GroupName="SplashThemes"
                            IsChecked="{x:Bind ViewModel.Appearance.IsThemeSelected(ViewModel.SettingsService.AppTheme, 'Light'), Mode=OneWay}" />
                        <RadioMenuFlyoutItem
                            l:Uids.Uid="ToolbarDarkTheme"
                            Command="{x:Bind ViewModel.Appearance.ChangeThemeCommand}"
                            CommandParameter="Dark"
                            GroupName="SplashThemes"
                            IsChecked="{x:Bind ViewModel.Appearance.IsThemeSelected(ViewModel.SettingsService.AppTheme, 'Dark'), Mode=OneWay}" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </Grid>
</common:TgPageBase>
