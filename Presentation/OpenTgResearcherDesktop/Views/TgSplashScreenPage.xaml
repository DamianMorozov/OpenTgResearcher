<common:TgPageBase
    x:Class="OpenTgResearcherDesktop.Views.TgSplashScreenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:OpenTgResearcherDesktop.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:OpenTgResearcherDesktop.Helpers"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:styles="using:OpenTgResearcherDesktop.Styles"
    xmlns:viewmodels="using:OpenTgResearcherDesktop.ViewModels"
    mc:Ignorable="d">

    <common:TgPageBase.Resources>
        <x:Double x:Key="ProgressBarTrackHeight">30</x:Double>
        <!--  Мягкие края головы и частиц короткого шлейфа у кнопки продолжения  -->
        <Style x:Key="SplashCometDotStyle" TargetType="Ellipse">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Fill">
                <Setter.Value>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Offset="0" Color="{ThemeResource SystemAccentColor}" />
                        <GradientStop Offset="0.35" Color="{ThemeResource SystemAccentColor}" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </common:TgPageBase.Resources>

    <Grid
        x:Name="MainContent"
        Padding="10"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <!--  Логотип приложения  -->
        <Grid
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Width="112"
            Height="112"
            Margin="0,8,0,16"
            HorizontalAlignment="Center">
            <!--  Неподвижный контур орбиты  -->
            <Ellipse
                Width="104"
                Height="104"
                Opacity="0.16"
                Stroke="{ThemeResource SystemControlForegroundAccentBrush}"
                StrokeThickness="2" />
            <!--  Дуга вращается, пока выполняются этапы загрузки  -->
            <Grid
                x:Name="SplashOrbit"
                Width="112"
                Height="112"
                IsHitTestVisible="False">
                <Path
                    Data="M 56,4 A 52,52 0 0 1 108,56"
                    Stroke="{ThemeResource SystemControlForegroundAccentBrush}"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="3" />
                <Ellipse
                    Width="5"
                    Height="5"
                    Margin="0,1,0,0"
                    VerticalAlignment="Top"
                    Fill="{ThemeResource SystemControlForegroundAccentBrush}" />
            </Grid>
            <ContentControl
                AutomationProperties.AutomationId="SplashLogo"
                AutomationProperties.Name="OTR"
                Style="{StaticResource TgAppLogoStyle}">
                <!--  Полоса света проходит поверх логотипа, не выходя за его область  -->
                <Border
                    x:Name="SplashScanBand"
                    Width="76"
                    Height="18"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="0.5" Color="#DDFFFFFF" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </ContentControl>
        </Grid>
        <!--  Версия приложения  -->
        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="0,0,0,30"
            HorizontalAlignment="Center"
            Style="{StaticResource TitleLargeTextBlockStyle}"
            Text="{x:Bind ViewModel.AppVersion}" />
        <!--  Загрузка  -->
        <StackPanel
            x:Name="SplashLoadingRows"
            Grid.Row="3"
            Grid.Column="1"
            Margin="0,10,0,0"
            Orientation="Vertical">
            <!--  Инициализация журналирования  -->
            <StackPanel
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <FontIcon
                    Margin="0,0,20,0"
                    Glyph="&#xE729;"
                    Visibility="{x:Bind ViewModel.IsLoadHardwareResourceMonitoring, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock l:Uids.Uid="TextBlockLoadingLogging" Style="{StaticResource TitleTextBlockStyle}" />
                <FontIcon
                    Margin="20,0,0,0"
                    Glyph="&#xE73E;"
                    Visibility="{x:Bind ViewModel.IsLoadLogging, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
            <!--  Инициализация установщика Velopack  -->
            <StackPanel
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <FontIcon
                    Margin="0,0,20,0"
                    Glyph="&#xE7B8;"
                    Visibility="{x:Bind ViewModel.IsLoadHardwareResourceMonitoring, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock l:Uids.Uid="TextBlockLoadingVelopack" Style="{StaticResource TitleTextBlockStyle}" />
                <FontIcon
                    Margin="20,0,0,0"
                    Glyph="&#xE73E;"
                    Visibility="{x:Bind ViewModel.IsLoadVelopack, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
            <!--  Загрузка настроек  -->
            <StackPanel
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <FontIcon
                    Margin="0,0,20,0"
                    Glyph="&#xE713;"
                    Visibility="{x:Bind ViewModel.IsLoadHardwareResourceMonitoring, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock l:Uids.Uid="TextBlockLoadingSettings" Style="{StaticResource TitleTextBlockStyle}" />
                <FontIcon
                    Margin="20,0,0,0"
                    Glyph="&#xE73E;"
                    Visibility="{x:Bind ViewModel.IsLoadSettings, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
            <!--  Загрузка хранилища  -->
            <StackPanel
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <FontIcon
                    Margin="0,0,20,0"
                    Glyph="&#xF12B;"
                    Visibility="{x:Bind ViewModel.IsLoadHardwareResourceMonitoring, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock l:Uids.Uid="TextBlockLoadingStorage" Style="{StaticResource TitleTextBlockStyle}" />
                <FontIcon
                    Margin="20,0,0,0"
                    Glyph="&#xE73E;"
                    Visibility="{x:Bind ViewModel.IsLoadStorage, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
            <!--  Загрузка лицензии  -->
            <StackPanel
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <FontIcon
                    Margin="0,0,20,0"
                    Glyph="&#xE8C7;"
                    Visibility="{x:Bind ViewModel.IsLoadHardwareResourceMonitoring, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock l:Uids.Uid="TextBlockLoadingLicense" Style="{StaticResource TitleTextBlockStyle}" />
                <FontIcon
                    Margin="20,0,0,0"
                    Glyph="&#xE73E;"
                    Visibility="{x:Bind ViewModel.IsLoadLicense, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
            <!--  Загрузка уведомлений  -->
            <StackPanel
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <FontIcon
                    Margin="0,0,20,0"
                    Glyph="&#xEC42;"
                    Visibility="{x:Bind ViewModel.IsLoadHardwareResourceMonitoring, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock l:Uids.Uid="TextBlockLoadingNotifications" Style="{StaticResource TitleTextBlockStyle}" />
                <FontIcon
                    Margin="20,0,0,0"
                    Glyph="&#xE73E;"
                    Visibility="{x:Bind ViewModel.IsLoadNotifications, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
            <!--  Загрузка мониторинга оборудования  -->
            <StackPanel
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <FontIcon
                    Margin="0,0,20,0"
                    Glyph="&#xE950;"
                    Visibility="{x:Bind ViewModel.IsLoadHardwareResourceMonitoring, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock l:Uids.Uid="TextBlockLoadingHardwareResourceMonitoring" Style="{StaticResource TitleTextBlockStyle}" />
                <FontIcon
                    Margin="20,0,0,0"
                    Glyph="&#xE73E;"
                    Visibility="{x:Bind ViewModel.IsLoadHardwareResourceMonitoring, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </StackPanel>
        <!--  Продолжение работы  -->
        <Grid
            x:Name="SplashContinueHost"
            Grid.Row="5"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Width="500"
            Margin="50,50,50,50"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="{x:Bind ViewModel.IsLoadComplete, Converter={StaticResource BoolToVisibilityConverter}}">
            <Button
                x:Name="SplashContinueButton"
                MinHeight="50"
                Margin="8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AutomationProperties.AutomationId="SplashContinue"
                Command="{x:Bind ViewModel.ContinueCommand}"
                FontWeight="Bold">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        l:Uids.Uid="ActionContinue"
                        HorizontalTextAlignment="Left"
                        Style="{StaticResource TitleTextBlockStyle}" />
                    <FontIcon Margin="30,0,10,0" Glyph="&#xF5B0;" />
                </StackPanel>
            </Button>
            <!--  Декоративный слой не перехватывает нажатия и обходит кнопку по часовой стрелке  -->
            <Canvas AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
                <Ellipse
                    x:Name="ContinueOrbitHead"
                    Width="14"
                    Height="14"
                    Style="{StaticResource SplashCometDotStyle}" />
                <Ellipse
                    x:Name="ContinueOrbitTailNear"
                    Width="10"
                    Height="10"
                    Style="{StaticResource SplashCometDotStyle}" />
                <Ellipse
                    x:Name="ContinueOrbitTailMiddle"
                    Width="8"
                    Height="8"
                    Style="{StaticResource SplashCometDotStyle}" />
                <Ellipse
                    x:Name="ContinueOrbitTailFar"
                    Width="6"
                    Height="6"
                    Style="{StaticResource SplashCometDotStyle}" />
            </Canvas>
        </Grid>
    </Grid>
</common:TgPageBase>
