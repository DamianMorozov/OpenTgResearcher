<common:TgPageBase
    x:Class="OpenTgResearcherDesktop.Views.TgStoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:OpenTgResearcherDesktop.Common"
    xmlns:l="using:WinUI3Localizer"
    xmlns:styles="using:OpenTgResearcherDesktop.Styles"
    xmlns:viewmodels="using:OpenTgResearcherDesktop.ViewModels">
    <Page.Resources>
        <CollectionViewSource
            x:Name="GroupedStories"
            IsSourceGrouped="True"
            Source="{x:Bind ViewModel.Groups, Mode=OneWay}" />
        <Style x:Key="StoryPanel" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="StorySecondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <DataTemplate x:Key="StoryRow" x:DataType="viewmodels:TgStoryJournalRow">
            <Grid Padding="8,7" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind Author}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource StorySecondary}"
                        Text="{x:Bind Caption}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Spacing="2">
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource StorySecondary}"
                        Text="{x:Bind Published}" />
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="5">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE917;"
                            Visibility="{x:Bind IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Style="{StaticResource StorySecondary}" Text="{x:Bind Status}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="16,4,16,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.IsPageStorageProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LoadColumn" Width="*" />
                    <ColumnDefinition x:Name="TelegramColumn" Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="ClearArchiveColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    AutomationProperties.AutomationId="StoriesLoadStorage"
                    Command="{x:Bind ViewModel.LoadDataStorageCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <TextBlock
                        l:Uids.Uid="StoriesLoad"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Button>
                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    AutomationProperties.AutomationId="StoriesReloadTelegram"
                    Command="{x:Bind ViewModel.StartUpdateOnlineCommand}"
                    IsEnabled="{x:Bind ViewModel.IsOnlineReady, Mode=OneWay}">
                    <TextBlock
                        l:Uids.Uid="StoriesUpdateTelegram"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Button>
                <Button
                    x:Name="ClearButton"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    AutomationProperties.AutomationId="StoriesClearView"
                    Command="{x:Bind ViewModel.ClearViewCommand}"
                    Style="{StaticResource SubtleButtonStyle}">
                    <TextBlock
                        l:Uids.Uid="ActionClearView"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Button>
                <Button
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    AutomationProperties.AutomationId="StoriesClearArchive"
                    Click="OnClearArchiveClick"
                    IsEnabled="{x:Bind ViewModel.IsArchiveIdle, Mode=OneWay}"
                    Style="{StaticResource SubtleButtonStyle}">
                    <TextBlock
                        l:Uids.Uid="StoriesClearArchive"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Button>
            </Grid>
        </ContentControl>
        <Grid
            Grid.Row="1"
            ColumnSpacing="8"
            Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                MinWidth="0"
                l:Uids.Uid="StoriesDirectory"
                AutomationProperties.AutomationId="StoriesArchiveDirectory"
                IsReadOnly="{x:Bind ViewModel.IsArchiveBusy, Mode=OneWay}"
                Text="{x:Bind ViewModel.ArchiveDirectoryInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <styles:TgAnimatedClipboardButton
                Grid.Column="1"
                Width="36"
                Height="32"
                VerticalAlignment="Bottom"
                l:Uids.Uid="StoriesCopyDirectory"
                AutomationProperties.AutomationId="StoriesCopyDirectory"
                Click="OnClipboardSilentWriteClick"
                IsEnabled="{x:Bind ViewModel.HasArchiveDirectoryInput, Mode=OneWay}"
                Style="{StaticResource ClipboardAnimatedButtonStyle}"
                Tag="{x:Bind ViewModel.ArchiveDirectoryInput, Mode=OneWay}" />
            <Button
                Grid.Column="2"
                VerticalAlignment="Bottom"
                l:Uids.Uid="StoriesChooseFolder"
                Click="OnChooseFolderClick"
                IsEnabled="{x:Bind ViewModel.IsArchiveIdle, Mode=OneWay}" />
            <Button
                Grid.Column="3"
                VerticalAlignment="Bottom"
                l:Uids.Uid="StoriesSaveDirectory"
                AutomationProperties.AutomationId="StoriesSaveDirectory"
                Command="{x:Bind ViewModel.SaveArchiveDirectoryCommand}" />
        </Grid>
        <StackPanel Grid.Row="2" Spacing="4">
            <Button
                l:Uids.Uid="StoriesCancelArchive"
                Command="{x:Bind ViewModel.CancelArchiveCommand}"
                Visibility="{x:Bind ViewModel.IsArchiveBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsPageStorageProcessing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsArchiveBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock
                Style="{StaticResource StorySecondary}"
                Text="{x:Bind ViewModel.ArchiveMessage, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <Grid
            Grid.Row="3"
            RowSpacing="10"
            Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    MinWidth="0"
                    l:Uids.Uid="StoriesSearch"
                    AutomationProperties.AutomationId="StoriesSearch"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox
                    Grid.Column="1"
                    l:Uids.Uid="StoriesFilter"
                    AutomationProperties.AutomationId="StoriesFilter"
                    SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}">
                    <ComboBoxItem l:Uids.Uid="StoriesFilterAll" />
                    <ComboBoxItem l:Uids.Uid="StoriesFilterActive" />
                    <ComboBoxItem l:Uids.Uid="StoriesFilterExpired" />
                    <ComboBoxItem l:Uids.Uid="StoriesFilterDeleted" />
                </ComboBox>
                <ComboBox
                    Grid.Column="2"
                    l:Uids.Uid="StoriesSort"
                    AutomationProperties.AutomationId="StoriesSort"
                    SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                    <ComboBoxItem l:Uids.Uid="StoriesSortDate" />
                    <ComboBoxItem l:Uids.Uid="StoriesSortName" />
                    <ComboBoxItem l:Uids.Uid="StoriesSortId" />
                </ComboBox>
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    MinWidth="0"
                    l:Uids.Uid="StoriesAuthorUsername"
                    AutomationProperties.AutomationId="StoriesAuthorUsername"
                    Text="{x:Bind ViewModel.AuthorUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ContentControl Grid.Column="1" IsEnabled="{x:Bind ViewModel.IsArchiveIdle, Mode=OneWay}">
                    <Button
                        l:Uids.Uid="StoriesDownloadAuthor"
                        AutomationProperties.AutomationId="StoriesDownloadAuthor"
                        Command="{x:Bind ViewModel.DownloadAuthorCommand}"
                        IsEnabled="{x:Bind ViewModel.IsOnlineReady, Mode=OneWay}" />
                </ContentControl>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.2*" />
                    <RowDefinition x:Name="DetailsRow" Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="DetailsColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Border Padding="8" Style="{StaticResource StoryPanel}">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="8,3" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                l:Uids.Uid="StoriesJournal"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource StorySecondary}"
                                Text="{x:Bind ViewModel.LoadedCount, Mode=OneWay}" />
                        </Grid>
                        <ListView
                            x:Name="StoriesJournalList"
                            Grid.Row="1"
                            AutomationProperties.AutomationId="StoriesJournalList"
                            ItemTemplate="{StaticResource StoryRow}"
                            ItemsSource="{Binding Source={StaticResource GroupedStories}}"
                            SelectedItem="{x:Bind ViewModel.SelectedStory, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate x:DataType="viewmodels:TgStoryJournalGroup">
                                            <TextBlock
                                                Margin="10,9,10,5"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Text="{x:Bind Header}"
                                                TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="2,0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <TextBlock
                            Grid.Row="1"
                            Margin="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            l:Uids.Uid="StoriesNoResults"
                            AutomationProperties.AutomationId="StoriesEmptyState"
                            Style="{StaticResource StorySecondary}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.IsJournalEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Border>
                <Border
                    x:Name="DetailsPane"
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    AutomationProperties.AutomationId="StoriesDetailsPane"
                    Style="{StaticResource StoryPanel}">
                    <Grid Padding="14" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            l:Uids.Uid="StoriesDetails"
                            FontSize="16"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="1"
                            l:Uids.Uid="StoriesSelect"
                            Style="{StaticResource StorySecondary}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    AutomationProperties.AutomationId="StorySelectedAuthor"
                                    FontWeight="SemiBold"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind ViewModel.SelectedStory.Author, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource StorySecondary}"
                                    Text="{x:Bind ViewModel.SelectedStory.Status, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    x:Name="StoryMedia"
                                    Spacing="8"
                                    Visibility="Collapsed">
                                    <Image
                                        x:Name="StoryPhoto"
                                        MaxHeight="310"
                                        l:Uids.Uid="StoriesPhoto"
                                        AutomationProperties.AutomationId="StoryArchivedPhoto"
                                        Stretch="Uniform"
                                        Visibility="Collapsed" />
                                    <MediaPlayerElement
                                        x:Name="StoryVideo"
                                        Height="270"
                                        AreTransportControlsEnabled="True"
                                        AutoPlay="False"
                                        AutomationProperties.AutomationId="StoryArchivedVideo"
                                        Visibility="Collapsed" />
                                    <TextBlock
                                        x:Name="StoryMediaNotice"
                                        Style="{StaticResource StorySecondary}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                    <Button
                                        x:Name="OpenStoryMedia"
                                        l:Uids.Uid="StoriesOpenMedia"
                                        Click="OnOpenMediaClick"
                                        Visibility="Collapsed" />
                                </StackPanel>
                                <Border
                                    Padding="10,8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="2,0,0,0"
                                    CornerRadius="6">
                                    <TextBlock
                                        AutomationProperties.AutomationId="StorySelectedCaption"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind ViewModel.SelectedStory.Caption, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </Border>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            l:Uids.Uid="StoriesPublished"
                                            Style="{StaticResource StorySecondary}"
                                            TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedStory.Published, Mode=OneWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock
                                            l:Uids.Uid="StoriesExpires"
                                            Style="{StaticResource StorySecondary}"
                                            TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedStory.Expires, Mode=OneWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="2">
                                    <TextBlock l:Uids.Uid="StoriesId" Style="{StaticResource StorySecondary}" />
                                    <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.SelectedStory.Id, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <TextBlock
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            l:Uids.Uid="StoriesPrivate"
            Style="{StaticResource StorySecondary}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.IsDisplaySensitiveData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="StoriesCompact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="StoriesWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1050" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailsColumn.Width" Value="0.9*" />
                        <Setter Target="DetailsRow.Height" Value="0" />
                        <Setter Target="DetailsPane.(Grid.Column)" Value="1" />
                        <Setter Target="DetailsPane.(Grid.Row)" Value="0" />
                        <Setter Target="DetailsPane.Margin" Value="12,0,0,0" />
                        <Setter Target="DetailsPane.VerticalAlignment" Value="Top" />
                        <Setter Target="LoadColumn.Width" Value="Auto" />
                        <Setter Target="TelegramColumn.Width" Value="Auto" />
                        <Setter Target="ClearArchiveColumn.Width" Value="Auto" />
                        <Setter Target="ClearButton.HorizontalAlignment" Value="Right" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</common:TgPageBase>
