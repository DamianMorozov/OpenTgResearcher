<common:TgPageBase
    x:Class="OpenTgResearcherDesktop.Views.TgUpdatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:OpenTgResearcherDesktop.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:OpenTgResearcherDesktop.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:TgUpdateViewModel}"
    mc:Ignorable="d">
    <Grid Padding="5,10,5,5" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  Проверка стабильной версии  -->
        <Button
            MinHeight="50"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.AutomationId="UpdateRelease"
            Command="{x:Bind ViewModel.UpdateReleaseCommand}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE72C;" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    l:Uids.Uid="ActionUpdateReleaseApp"
                    TextWrapping="Wrap" />
            </Grid>
        </Button>
        <!--  Проверка предварительной версии  -->
        <Button
            Grid.Row="1"
            MinHeight="50"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.AutomationId="UpdatePreview"
            Command="{x:Bind ViewModel.UpdatePreviewCommand}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE72C;" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    l:Uids.Uid="ActionUpdatePreviewApp"
                    TextWrapping="Wrap" />
            </Grid>
        </Button>
        <!--  Прогресс проверки и скачивания  -->
        <Grid
            Grid.Row="2"
            ColumnSpacing="10"
            Visibility="{x:Bind ViewModel.IsUpdating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar
                VerticalAlignment="Center"
                IsIndeterminate="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                Maximum="100"
                Minimum="0"
                Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}" />
            <Button
                Grid.Column="1"
                l:Uids.Uid="ActionCancelUpdate"
                Command="{x:Bind ViewModel.CancelUpdateCommand}" />
        </Grid>
        <TextBlock
            Grid.Row="3"
            l:Uids.Uid="UpdateLogCaption"
            Style="{ThemeResource BodyStrongTextBlockStyle}" />
        <!--  Журнал доступен для чтения, выделения и копирования  -->
        <TextBox
            Grid.Row="4"
            VerticalAlignment="Stretch"
            AcceptsReturn="True"
            AutomationProperties.AutomationId="UpdateLog"
            IsReadOnly="True"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            Text="{x:Bind ViewModel.UpdateLog, Mode=OneWay}"
            TextWrapping="Wrap" />
    </Grid>
</common:TgPageBase>
