<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Core/TgBusinessLogic/TgBusinessLogic.csproj" />
    <Compile Include="../../../Presentation/OpenTgResearcherDesktop/ViewModels/TgChat*ViewModel.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../../Presentation/OpenTgResearcherDesktop/Views/TgChatPage.xaml.cs" Link="TgChatPage.xaml.cs" />
    <EmbeddedResource Include="../../../Presentation/OpenTgResearcherDesktop/Views/TgChat*Page.xaml" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../Presentation/OpenTgResearcherDesktop/Styles/TgChatResources.xaml" LogicalName="TgChatResources.xaml" />
    <EmbeddedResource Include="Fixtures/cover.jpg" LogicalName="cover.jpg" />
    <EmbeddedResource Include="../../../Presentation/OpenTgResearcherConsole/Helpers/TgMenuHelperClientConDownload.cs"
        LogicalName="ConsoleDownload.cs" />
    <Compile Include="../../../Presentation/OpenTgResearcherDesktop/Models/TgChatActivityRow.cs" Link="TgChatActivityRow.cs" />
    <Compile Include="../../../Presentation/OpenTgResearcherDesktop/Models/TgChatRegistryRow.cs" Link="TgChatRegistryRow.cs" />
  </ItemGroup>
</Project>
