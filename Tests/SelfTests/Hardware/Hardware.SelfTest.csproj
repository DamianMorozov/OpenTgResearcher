<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Core/TgBusinessLogic/TgBusinessLogic.csproj" />
    <Compile Include="../../../Presentation/OpenTgResearcherDesktop/Models/TgHardware*.cs" Link="%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../Presentation/OpenTgResearcherDesktop/Views/TgHardwareResourcePage.xaml" LogicalName="Hardware.xaml" />
    <EmbeddedResource Include="../../../Presentation/OpenTgResearcherDesktop/Views/ShellPage.xaml" LogicalName="Shell.xaml" />
    <Content Include="../../../Presentation/OpenTgResearcherDesktop/Strings/**/Resources.resw" Link="Strings/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
