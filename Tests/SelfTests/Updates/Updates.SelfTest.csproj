<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Presentation/OpenTgResearcherDesktop/ViewModels/TgNetworkActivityViewModel.cs" Link="TgNetworkActivityViewModel.cs" />
    <Compile Include="../../../Presentation/OpenTgResearcherDesktop/Models/TgNetworkOperationModel.cs" Link="TgNetworkOperationModel.cs" />
