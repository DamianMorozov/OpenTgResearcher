<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Core/TgInfrastructure/TgInfrastructure.csproj" />
    <Compile Include="../../../Presentation/OpenTgResearcherDesktop/ViewModels/TgUpdateViewModel.cs" Link="TgUpdateViewModel.cs" />
    <Compile Include="../../../Presentation/OpenTgResearcherDesktop/Services/NavigationViewService.cs" Link="NavigationViewService.cs" />
    <Compile Include="../../../Presentation/OpenTgResearcherDesktop/Helpers/TgResourceExtensions.cs" Link="TgResourceExtensions.cs" />
    <Content Include="../../../Presentation/OpenTgResearcherDesktop/Strings/**/Resources.resw" Link="Strings/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="../../../Presentation/OpenTgResearcherDesktop/Views/TgUpdatePage.xaml" LogicalName="TgUpdatePage.xaml" />
  </ItemGroup>
</Project>
